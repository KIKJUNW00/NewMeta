package com.newmeta.persistence;

import java.util.List;
import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;

import com.newmeta.domain.AnomalyLog;
import com.newmeta.domain.dto.AnomalyDTO;

public interface AnomalyLogRepository extends JpaRepository<AnomalyLog, Long> {
	
	@Query("SELECT new com.newmeta.domain.dto.AnomalyDTO(a.anomalyId, a.anomalyType, a.reason, " +
		       "p.epcCode, p.productName, e.eventType, h.hubName, h.latitude, h.longitude, a.anomalyTimestamp) " +
		       "FROM AnomalyLog a " +
		       "JOIN a.productEventLog pel " +
		       "JOIN pel.product p " +
		       "JOIN pel.event e " +
		       "JOIN pel.hub h")
		List<AnomalyDTO> findAllAnomalyDetails();



	 
	List<AnomalyLog> findByEpcCode(String epcCode);
	List<AnomalyLog> findByAnomalyProductNameContaining(String anomalyProductName);
	Optional<AnomalyLog> findByEpcCodeAndAnomalyEventType(String epcCode, String anomalyEventType);
	boolean existsByEpcCode(String epcCode);


}
