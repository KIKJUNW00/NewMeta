package com.newmeta.service;

import com.newmeta.domain.AnomalyLog;
import com.newmeta.domain.Dummy;
import com.newmeta.domain.ProductEventLog;
import com.newmeta.event.SCMDataUpdateEvent;
import com.newmeta.persistence.ProductEventLogRepository;
import com.newmeta.persistence.AnomalyLogRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.ApplicationEventPublisher;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class SCMDataService {

	private final ProductEventLogRepository productEventLogRepository;
	private final AnomalyLogRepository anomalyLogRepository;
	private final AnomalyDetectionService anomalyDetectionService; // ✅ 이상 탐지 서비스 추가
	private final SimpMessagingTemplate messagingTemplate;
	private final ApplicationEventPublisher eventPublisher;
	private static final String DOMESTIC_PREFIX = "880"; // 국내산 제품 EPC 코드 시작값

	// ✅ 5초마다 실시간 데이터를 STOMP로 전송
	@Scheduled(fixedRate = 5000)
	public void sendSCMDataAutomatically() {
		sendSCMDataUpdate();
		sendAnomalyUpdates(); // ✅ 5초마다 자동으로 이상 탐지 실행 및 전송
	}

	/**
	 * 🚀 실시간 거점별 국내산 & 수입산 제품의 SCM 공정 데이터 반환
	 */
	public Map<String, Object> getSCMData() {
		List<ProductEventLog> logs = productEventLogRepository.findAll();
		Map<String, Object> hubWiseData = logs.stream().collect(Collectors.groupingBy(log -> log.getHub().getHubName(),
				Collectors.collectingAndThen(Collectors.toList(), this::groupByDomesticAndProcess)));
		return Map.of("hubWiseData", hubWiseData);
	}

	/**
	 * ✅ anomaly_log에서 이상 탐지 기록 조회 (위도, 경도 추가)
	 */
	public List<Map<String, Object>> getAnomalyData() {
		return anomalyLogRepository.findAll().stream().map(log -> {
			Map<String, Object> anomaly = new HashMap<>();
			anomaly.put("hub", log.getAnomalyHub());
			anomaly.put("product", log.getAnomalyProductName());
			anomaly.put("eventType", log.getAnomalyEventType());
			anomaly.put("status", log.getAnomalyType());
			anomaly.put("reason", log.getReason());
			anomaly.put("latitude", log.getLatitude()); // ✅ 위치 정보 추가
			anomaly.put("longitude", log.getLongitude());
			return anomaly;
		}).collect(Collectors.toList());
	}

	/**
	 * ✅ 이상 탐지 실행 (ProductEventLog 데이터 활용)
	 */
	public List<Map<String, Object>> detectAnomalies() {
		List<ProductEventLog> logs = productEventLogRepository.findAll();
		for (ProductEventLog log : logs) {
			// ✅ 기존 `dummy = null` 로직을 대체하여 기본 Dummy 객체 생성
			Dummy dummy = createDummyFromEventLog(log);
			anomalyDetectionService.detectAnomalies(dummy, log);
		}
		return getAnomalyData(); // ✅ 탐지된 이상치 반환
	}

	/**
	 * ✅ STOMP 메시지 브로커를 통한 이상 탐지 데이터 전송
	 */
	public void sendAnomalyUpdates() {
		List<Map<String, Object>> anomalies = detectAnomalies();
		messagingTemplate.convertAndSend("/topic/anomalyAlerts", anomalies);
		log.info("📡 이상 탐지 결과 STOMP WebSocket으로 전송 완료: {}", anomalies);
	}

	/**
	 * 🚀 국내산 여부 판별 (EPC 코드 확인)
	 */
	private boolean isDomesticProduct(String epcCode) {
		if (epcCode == null || epcCode.isEmpty())
			return false;
		String[] parts = epcCode.split("\\.");
		return parts.length > 2 && parts[1].startsWith(DOMESTIC_PREFIX);
	}

	/**
	 * 🚀 특정 거점에서 국내산 & 수입산 제품을 SCM 공정별 수량으로 변환
	 */
	private Map<String, Object> groupByDomesticAndProcess(List<ProductEventLog> logs) {
		Map<String, Long> domesticCounts = countByEventType(logs, true);
		Map<String, Long> importCounts = countByEventType(logs, false);
		return Map.of("domestic", domesticCounts, "imported", importCounts);
	}

	/**
	 * 🚀 특정 리스트에서 공정별 제품 수량 집계
	 */
	private Map<String, Long> countByEventType(List<ProductEventLog> logs, boolean isDomestic) {
		return logs.stream().filter(log -> isDomesticProduct(log.getProduct().getEpcCode()) == isDomestic)
				.collect(Collectors.groupingBy(log -> log.getEvent().getEventType(), Collectors.counting()));
	}

	/**
	 * ✅ STOMP 메시지 브로커를 통한 실시간 데이터 전송 기능 추가
	 */
	public void sendSCMDataUpdate() {
		Map<String, Object> scmData = getSCMData();
		log.info("📡 STOMP WebSocket을 통한 SCM 데이터 전송: {}", scmData);
		messagingTemplate.convertAndSend("/topic/scmDataUpdate", scmData);
	}

	/**
	 * ✅ Spring 이벤트 기반으로 실시간 데이터 업데이트 알림
	 */
	public void publishSCMDataUpdateEvent() {
		Map<String, Object> scmData = getSCMData();
		log.info("📡 Spring 이벤트를 통한 SCM 데이터 업데이트 전송: {}", scmData);
		eventPublisher.publishEvent(new SCMDataUpdateEvent(this, scmData));
	}

	/**
	 * ✅ ProductEventLog를 기반으로 기본 Dummy 객체 생성
	 */
	private Dummy createDummyFromEventLog(ProductEventLog log) {
		if (log == null || log.getProduct() == null || log.getEvent() == null || log.getHub() == null) {
			this.log.warn("⚠️ Dummy 생성 실패: 이벤트 로그 또는 제품 정보가 NULL");
			return new Dummy("", "Unknown Product", "Unknown Hub", "Unknown Event", new Date(), 0.0, 0.0); // 기본값 설정
		}

		return new Dummy(log.getProduct().getEpcCode(), log.getProduct().getProductName(), log.getHub().getHubName(),
				log.getEvent().getEventType(), log.getEventTime(), log.getHub().getLatitude(),
				log.getHub().getLongitude());
	}

}
