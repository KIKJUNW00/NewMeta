package com.newmeta.controller;

import com.newmeta.service.SCMDataService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;

@Slf4j
@RestController
@RequestMapping("/api/scm")
@RequiredArgsConstructor
public class SCMController {

    private final SCMDataService scmDataService;
    private final SimpMessagingTemplate messagingTemplate;

    /**
     * ✅ 기존 REST API 방식으로 SCM 데이터 조회
     */
    @GetMapping("/data")
    public @ResponseBody Map<String, Object> getSCMData() {
        return scmDataService.getSCMData();
    }

    /**
     * ✅ anomaly_log에서 이상 탐지 데이터 조회
     */
    @GetMapping("/anomalies")
    public List<Map<String, String>> getAnomalyData() {
        return scmDataService.getAnomalyData();
    }

    /**
     * ✅ 이상 탐지 실행 및 STOMP 메시지 전송
     */
    @PostMapping("/detect-anomalies")
    public ResponseEntity<String> detectAnomalies() {
        List<Map<String, String>> anomalies = scmDataService.detectAnomalies();
        if (!anomalies.isEmpty()) {
            messagingTemplate.convertAndSend("/topic/anomalyAlerts", anomalies);
            log.info("📡 이상 탐지 결과 STOMP WebSocket으로 전송 완료");
        }
        return ResponseEntity.ok("Anomaly detection process complete");
    }
}
