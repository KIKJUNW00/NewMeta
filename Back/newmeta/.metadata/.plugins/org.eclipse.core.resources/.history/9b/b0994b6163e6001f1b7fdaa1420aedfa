package com.newmeta.cache;

import com.newmeta.domain.ProductEventLog;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.CopyOnWriteArrayList;

/**
 * 📌 EPC별 이벤트 히스토리를 저장하는 캐시 (ConcurrentHashMap 사용)
 * - 동시성 문제 해결 + CopyOnWriteArrayList로 이벤트 추가 및 조회
 */
@Component
@Slf4j
public class EventHistoryCache {

    // ConcurrentHashMap과 CopyOnWriteArrayList 사용
    private final ConcurrentHashMap<String, CopyOnWriteArrayList<ProductEventLog>> eventCache = new ConcurrentHashMap<>();

    /**
     * 📌 이벤트 추가 (동시성 안전)
     */
    public void addEvent(ProductEventLog eventLog) {
        if (eventLog == null || eventLog.getProduct() == null) {
            log.warn("⚠️ [addEvent] 이벤트 또는 제품정보 NULL");
            return;
        }
        String epc = eventLog.getProduct().getEpcCode();

        // ConcurrentHashMap에 EPC 코드로 이벤트 리스트 추가 또는 갱신
        eventCache.computeIfAbsent(epc, k -> new CopyOnWriteArrayList<>()).add(eventLog);

        log.debug("✅ 이벤트 추가: EPC={} | 현재 이벤트 수={}", epc, eventCache.get(epc).size());
    }

    /**
     * 📌 EPC별 이벤트 리스트 조회 (동시성 안전)
     */
    public List<ProductEventLog> getEventsByEpc(String epcCode) {
        return eventCache.getOrDefault(epcCode, new CopyOnWriteArrayList<>());
    }

    /**
     * 📌 EPC 이력 제거 (동시성 안전)
     */
    public void removeEventHistory(String epcCode) {
        if (eventCache.containsKey(epcCode)) {
            eventCache.remove(epcCode);
            log.debug("🗑 캐시 제거: EPC={}", epcCode);
        }
    }

    /**
     * 📌 캐시 상태 출력 (디버깅)
     */
    public void printCacheStatus() {
        log.info("📊 EventHistoryCache size: {}", eventCache.size());
        eventCache.forEach((epc, list) ->
                log.info(" - EPC={} | events={}", epc, list.size())
        );
    }
}
