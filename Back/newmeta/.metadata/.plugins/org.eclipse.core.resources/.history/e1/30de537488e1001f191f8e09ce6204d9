package com.newmeta.config; // 해당 설정 파일이 속한 패키지를 선언

import org.springframework.context.annotation.Configuration; // 스프링 설정 클래스를 선언하는 어노테이션
import org.springframework.messaging.simp.config.MessageBrokerRegistry; // 메시지 브로커 설정을 위한 클래스
import org.springframework.web.socket.config.annotation.EnableWebSocketMessageBroker; // STOMP(WebSocket 메시지 브로커) 활성화 어노테이션
import org.springframework.web.socket.config.annotation.StompEndpointRegistry; // STOMP 엔드포인트 설정을 위한 클래스
import org.springframework.web.socket.config.annotation.WebSocketMessageBrokerConfigurer; // WebSocket 메시지 브로커 설정을 위한 인터페이스

/**
 * 📌 WebSocket 설정 파일
 * ✅ STOMP 프로토콜을 활용한 실시간 메시지 브로커 구성
 */
@Configuration // Spring 설정 클래스
@EnableWebSocketMessageBroker // ✅ STOMP 메시지 브로커 활성화 (WebSocket을 메시지 기반으로 활용 가능하도록 설정)
public class WebSocketConfig implements WebSocketMessageBrokerConfigurer {

    /**
     * 🚀 STOMP 기반 WebSocket 엔드포인트 설정
     * @param registry STOMP 엔드포인트 등록을 위한 객체
     */
    @Override
    public void registerStompEndpoints(StompEndpointRegistry registry) {
        registry.addEndpoint("/ws-stomp") // ✅ WebSocket 연결을 위한 엔드포인트 설정 (React 등 클라이언트에서 접속 가능)
                .setAllowedOrigins("http://localhost:3000") // ✅ CORS 설정: React(프론트엔드)에서 연결 가능하도록 허용
                .withSockJS(); // ✅ SockJS 지원 추가 (WebSocket 미지원 브라우저에서 폴백 지원)
    }

    /**
     * 🚀 메시지 브로커 설정
     * @param registry 메시지 브로커를 등록하는 객체
     */
    @Override
    public void configureMessageBroker(MessageBrokerRegistry registry) {
        registry.enableSimpleBroker("/topic"); // ✅ 클라이언트가 구독할 수 있는 메시지 브로커 주제 설정 (예: "/topic/scmDataUpdate")
        registry.setApplicationDestinationPrefixes("/app"); // ✅ 클라이언트가 서버로 메시지를 전송할 때 사용하는 접두어 설정
    }
}
