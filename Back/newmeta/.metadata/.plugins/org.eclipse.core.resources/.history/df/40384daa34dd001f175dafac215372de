package com.newmeta.persistence;

import java.util.List;
import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;

import com.newmeta.domain.Dummy;
import com.newmeta.domain.Event;

public interface EventRepository extends JpaRepository<Event, Long> {
	  Optional<Event> findByEventType(String eventType);

	List<Dummy> findByEpcCodeAndEventTypeNot(String epcCode, String eventType);

	List<Dummy> findByEpcCodeAndHubTypeNot(String epcCode, String hubType);

	List<Dummy> findByEpcCodeAndEventType(String epcCode, String eventType);

}
