package com.newmeta.service;

import org.springframework.stereotype.Service;
import com.newmeta.domain.AnomalyLog;
import com.newmeta.domain.Dummy;
import com.newmeta.domain.ProductEventLog;
import com.newmeta.persistence.AnomalyLogRepository;
import com.newmeta.persistence.ProductEventLogRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Service
@RequiredArgsConstructor
@Slf4j
public class AnomalyDetectionService {

    private final AnomalyLogRepository anomalyLogRepository;
    private final ProductEventLogRepository productEventLogRepository;

    /**
     * 🚀 이상 탐지 로직 (필수 검출 규칙 적용)
     */
    public void detectAnomalies(Dummy dummy, ProductEventLog eventLog) {
        boolean isAnomaly = false;
        String anomalyType = "";
        String reason = "";

        // 🔍 국내산 여부 확인 (001. 포함된 경우도 고려)
        boolean isDomestic = isDomesticProduct(dummy.getEpcCode());

        log.info("🔍 EPC [{}] - 국내산 여부: {}", dummy.getEpcCode(), isDomestic);

        // ✅ [규칙 1] 국내산 제품이 commissioning 없이 이동 → 위조
        if (isDomestic && !hasEventType(dummy.getEpcCode(), "commissioning")
            && !dummy.getEventType().equals("commissioning")) {
            isAnomaly = true;
            anomalyType = "위조";
            reason = "Commissioning 없이 다른 단계에서 감지됨.";
        }

        // ✅ [규칙 2] 수입산 제품이 Custom_inbound 없이 이동 → 밀수
        if (!isDomestic && !hasCustomInbound(dummy.getEpcCode())
            && !dummy.getEventType().equals("Custom_inbound")) {
            isAnomaly = true;
            anomalyType = "밀수";
            reason = "수입산 제품이 Custom_inbound 없이 유통됨.";
        }

        // ✅ [규칙 3] commissioning 없이 다른 이벤트 발생 → 위조
        if (!hasEventType(dummy.getEpcCode(), "commissioning")
            && !dummy.getEventType().equals("commissioning")) {
            isAnomaly = true;
            anomalyType = "위조";
            reason = "Commissioning 없이 제품 이동 감지됨.";
        }

        // ✅ [규칙 4] aggregation 이후 disaggregation 없이 이동 → 불법 유통
        if (hasEventType(dummy.getEpcCode(), "aggregation")
            && !hasEventType(dummy.getEpcCode(), "disaggregation")
            && !dummy.getEventType().equals("disaggregation")) {
            boolean hasValidInbound = hasEventType(dummy.getEpcCode(), "WMS_inbound")
                                    || hasEventType(dummy.getEpcCode(), "stock_inbound");
            if (!hasValidInbound) {
                isAnomaly = true;
                anomalyType = "불법 유통";
                reason = "Aggregation 해제 없이 유통됨.";
            }
        }

        // ✅ [규칙 5] Custom_inbound 없이 수입산 제품 이동 → 밀수
        if (!isDomestic && !hasEventType(dummy.getEpcCode(), "Custom_inbound")) {
            isAnomaly = true;
            anomalyType = "밀수";
            reason = "Custom_inbound 없이 이동 감지됨.";
        }

        // ✅ [규칙 6] Read Point에서 일련번호 누락 → 불법 유통
        if (!hasSerialNumber(dummy.getEpcCode())) {
            isAnomaly = true;
            anomalyType = "불법 유통";
            reason = "Read Point에서 일련번호 누락됨.";
        }

//        // ✅ [규칙 7] 필수 Read Point 감지 누락 → 위조 / 불법 유통
//        if (!hasEssentialReadPoint(dummy.getEpcCode())) {
//            isAnomaly = true;
//            anomalyType = "위조 / 불법 유통";
//            reason = "필수 Read Point 감지 없음.";
//        }

        // ✅ [규칙 8] 이벤트 순서 오류 → 위조 / 불법 유통
        if (isEventSequenceInvalid(dummy.getEpcCode(), dummy.getEventType())) {
            isAnomaly = true;
            anomalyType = "위조 / 불법 유통";
            reason = "이벤트 순서 오류 발생.";
        }

        // ✅ 정상 제품이면 anomalyLog를 null로 설정
        if (!isAnomaly) {
            log.info("✅ 정상 처리: EPC [{}] - 이벤트 [{}]", dummy.getEpcCode(), dummy.getEventType());
            eventLog.setAnomalyLog(null);
            productEventLogRepository.save(eventLog);
            return;
        }

        // ✅ 이상 탐지된 경우 anomalyLog 저장
        saveAnomalyLog(eventLog, anomalyType, reason);
    }

    /**
     * 🚀 국내산 여부 확인 (EPC 코드 기반)
     */
    private boolean isDomesticProduct(String epcCode) {
        if (epcCode == null || epcCode.isEmpty()) {
            return false;
        }
        String[] parts = epcCode.split("\\.");

        // ✅ "880"이 포함된 경우 국내산으로 처리
        return parts.length > 2 && parts[1].startsWith("880");
    }

    /**
     * ✅ 특정 EPC 코드와 이벤트 타입 존재 여부 확인
     */
    private boolean hasEventType(String epcCode, String eventType) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, eventType);
    }

    /**
     * ✅ Custom_inbound 이벤트 존재 여부 확인
     */
    private boolean hasCustomInbound(String epcCode) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, "Custom_inbound");
    }

    /**
     * ✅ Read Point에서 일련번호 존재 여부 확인
     */
    private boolean hasSerialNumber(String epcCode) {
        return productEventLogRepository.existsByProductEpcCode(epcCode);
    }

    /**
     * ✅ 필수 Read Point 감지 여부 확인
     */
    private boolean hasEssentialReadPoint(String epcCode) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, "ReadPoint");
    }

    /**
     * ✅ 이벤트 순서 오류 확인
     */
    private boolean isEventSequenceInvalid(String epcCode, String eventType) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, "event_order_error");
    }

    /**
     * ✅ 이상 로그 저장
     */
    private void saveAnomalyLog(ProductEventLog eventLog, String anomalyType, String reason) {
        AnomalyLog anomalyLog = AnomalyLog.builder()
                .anomalyType(anomalyType)
                .reason(reason)
                .epcCode(eventLog.getProduct().getEpcCode())
                .productName(eventLog.getProduct().getProductName())
                .eventTime(eventLog.getEventTime())
                .hubType(eventLog.getHub().getHubName())
                .eventType(eventLog.getEvent().getEventType())
                .latitude(eventLog.getHub().getLatitude())  // ✅ 위도 추가
                .longitude(eventLog.getHub().getLongitude()) // ✅ 경도 추가
                .productEventLog(eventLog)
                .build();

        anomalyLogRepository.save(anomalyLog);
        eventLog.setAnomalyLog(anomalyLog);
        productEventLogRepository.save(eventLog);

        log.info("❗ 이상 탐지 기록됨: EPC [{}] - {}, 위치: ({}, {})",
                eventLog.getProduct().getEpcCode(), reason,
                eventLog.getHub().getLatitude(), eventLog.getHub().getLongitude());
    }
}
