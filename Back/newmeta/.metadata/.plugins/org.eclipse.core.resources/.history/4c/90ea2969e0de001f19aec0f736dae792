package com.newmeta.config;

import org.springframework.context.annotation.Configuration;
import org.springframework.web.socket.config.annotation.EnableWebSocket;
import org.springframework.web.socket.config.annotation.WebSocketConfigurer;
import org.springframework.web.socket.config.annotation.WebSocketHandlerRegistry;
import com.newmeta.websocket.SCMWebSocketHandler;
import lombok.RequiredArgsConstructor;

@Configuration
@EnableWebSocket
@RequiredArgsConstructor
public class WebSocketConfig implements WebSocketConfigurer {

    private final SCMWebSocketHandler scmWebSocketHandler;

    @Override
    public void registerWebSocketHandlers(WebSocketHandlerRegistry registry) {
        registry.addHandler(scmWebSocketHandler, "/ws/scm-realtime")
                .setAllowedOrigins(
                        "http://localhost:3000",  // React 개발 서버
                        "http://localhost:8080",  // Spring Boot 서버
                        "ws://localhost:8080",    // WebSocket 연결
                        "http://127.0.0.1:8080",  // IPv4 형식
                        "https://localhost:8080"  // HTTPS 허용
                );
    }
}
