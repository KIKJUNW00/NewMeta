

package com.newmeta.config;

import org.springframework.context.annotation.Configuration;
import org.springframework.web.servlet.config.annotation.CorsRegistry;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;

@Configuration
public class WebConfig implements WebMvcConfigurer {

    @Override
    public void addCorsMappings(CorsRegistry registry) {
        // ✅ REST API CORS 설정
        registry.addMapping("/**") // 모든 경로에 대해 CORS 적용
                .allowedOrigins("http://localhost:3000") // React 클라이언트에서의 요청 허용
                .allowedMethods("GET", "POST", "PUT", "DELETE", "OPTIONS") // HTTP 메소드 허용
                .allowedHeaders("*") // 모든 헤더 허용
                .allowCredentials(true) // 쿠키 포함 요청 허용
                .exposedHeaders("Authorization"); // 클라이언트가 접근할 수 있는 응답 헤더 설정

        // ✅ WebSocket CORS 설정 (WebSocketConfig에서 설정했으므로 불필요)
    }
}


