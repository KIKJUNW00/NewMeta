package com.newmeta.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.newmeta.domain.Board;
import com.newmeta.service.BoardService;

import lombok.RequiredArgsConstructor;

@RestController
@RequestMapping("/board")
@RequiredArgsConstructor
public class AdminController {

    @Autowired
    private BoardService adminService;

    // 모든 게시글 조회 (GET /board)
    @GetMapping
    public List<Board> getAllAdmins() {
    	System.out.println("모든 게시글 조회");
        return adminService.getAllAdmins();
    }

    // 특정 게시글 조회 (GET /board/{id})
    @GetMapping("/{seq}")
    public Board getAdminById(@PathVariable Long seq) {
    	System.out.println(seq + "조회 성공");
    	return adminService.getAdminById(seq);
    }

    // 게시글 생성 (POST /board)
    @PostMapping
    public Board createAdmin(@RequestBody Board admin) {
    	System.out.println(admin + "게시글 생성");
        return adminService.saveAdmin(admin);
    }

    
 // 게시글 수정 (PUT /board/{seq})
    @PutMapping("/{seq}")
    public Board updateAdmin(@PathVariable Long seq, @RequestBody Board updatedAdmin) {
        System.out.println(seq + " 게시글 수정");
        return adminService.updateAdmin(seq, updatedAdmin);
    }

    // 게시글 삭제 (DELETE /board/{seq})
    @DeleteMapping("/{seq}")
    public String deleteAdmin(@PathVariable Long seq) {
    	adminService.deleteAdmin(seq);
        return seq + "번 게시글 삭제 완료";
    }
}