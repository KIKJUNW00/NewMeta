package com.newmeta.service;

import com.newmeta.cache.EventHistoryCache; // 이벤트 히스토리를 메모리에 저장하는 캐시
import com.newmeta.domain.AnomalyLog; // 이상 탐지 로그 엔티티
import com.newmeta.domain.ProductEventLog; // 제품 이벤트 로그 엔티티
import com.newmeta.domain.dto.AnomalyDTO; // 이상 탐지 데이터 전송을 위한 DTO
import com.newmeta.persistence.AnomalyLogRepository; // 이상 탐지 로그 레포지토리
import com.newmeta.persistence.ProductEventLogRepository; // 제품 이벤트 로그 레포지토리
import lombok.RequiredArgsConstructor; // 생성자 자동 생성 (의존성 주입을 위한 Lombok 어노테이션)
import lombok.extern.slf4j.Slf4j; // 로깅을 위한 Lombok 어노테이션
import org.springframework.stereotype.Service; // 서비스 계층을 나타내는 어노테이션

import java.util.*; // 유틸리티 클래스 (List, Map 등)
import java.util.stream.Collectors; // 스트림 사용을 위한 유틸리티

/**
 * 📌 이상 탐지 로직 서비스
 * - 새 이벤트 수신 시 processEvent → 캐시에 저장 → 필수 이벤트 개수 충족 시 detectAnomalies 실행
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class AnomalyDetectionService {

    // JPA 레포지토리 의존성 주입
    private final AnomalyLogRepository anomalyLogRepository;
    private final ProductEventLogRepository productEventLogRepository;
    private final WebSocketService webSocketService;
    private final EventHistoryCache eventHistoryCache;
    private final FastAPIService fastAPIService; // ✅ FastAPI 호출 기능 주석 처리

    // 국내산 및 수입산 이벤트 개수 제한
    private static final String DOMESTIC_PREFIX = "001.880"; // 국내산 EPC 코드 접두사
    private static final int DOMESTIC_EVENT_LIMIT = 10; // 국내산 이벤트 최소 개수
    private static final int IMPORTED_EVENT_LIMIT = 8; // 수입산 이벤트 최소 개수

    /**
     * 📌 이벤트 처리 메인 로직
     * - 캐시에 이벤트 저장 후 필수 이벤트 개수 충족 여부 확인
     * - 필수 이벤트 개수 부족 시 detectAnomalies에서 "필수 이벤트 누락"으로 이상 탐지 기록
     */
    public void processEvent(ProductEventLog eventLog) {
        if (eventLog == null || eventLog.getProduct() == null) {
            log.warn("❗ [processEvent] 이벤트 데이터가 NULL");
            return;
        }
        String epcCode = eventLog.getProduct().getEpcCode();
        
        // **이벤트 기본값을 정상(`false`)으로 설정**
        eventLog.setIsAnomaly(false);
        productEventLogRepository.save(eventLog);


        // 캐시에 이벤트 추가
        eventHistoryCache.addEvent(eventLog);
        List<ProductEventLog> storedEvents = eventHistoryCache.getEventsByEpc(epcCode);

        boolean isDomestic = isDomesticProduct(epcCode);
        int eventLimit = isDomestic ? DOMESTIC_EVENT_LIMIT : IMPORTED_EVENT_LIMIT;

        // 이벤트 개수 부족 시 detectAnomalies로 넘어가 "필수 이벤트 누락" 이상 탐지 기록
        if (storedEvents.size() < eventLimit) {
            log.warn("⏳ [이벤트 대기] EPC={} | 현재 이벤트 수={} / 필요 이벤트 수={}", epcCode, storedEvents.size(), eventLimit);
            return;
        }

        log.info("🚀 [이상 탐지 실행 준비 완료] EPC={} | 이벤트 수={}", epcCode, storedEvents.size());
        detectAnomalies(epcCode, storedEvents);
    }

    /**
     * 📌 이상 탐지 실행
     * - 데이터 변조, 첫 이벤트 검증, 허브 이동 없이 판매, 허용되지 않은 이벤트 탐지
     * - 마지막 단계에서 이벤트 순서 및 필수 이벤트 누락 여부 확인
     */
    private void detectAnomalies(String epcCode, List<ProductEventLog> events) {
        log.info("🚀 [detectAnomalies] EPC={} | 이벤트 수={}", epcCode, events.size());

        if (isDomesticProduct(epcCode) && !isDomesticFirstEventValid(events)) {
            saveAnomalyLog(events, "위조", "commissioning 이후 첫 이벤트가 올바르지 않음");
            return;
        }
        if (!isDomesticProduct(epcCode) && !isImportedFirstEventValid(events)) {
            saveAnomalyLog(events, "밀수", "custom_inbound 이후 첫 이벤트가 잘못됨");
            return;
        }
        if (isDirectlySoldWithoutHub(events)) {
            saveAnomalyLog(events, "불법 유통", "허브 이동 없이 판매 발생");
            return;
        }
        if (hasUnauthorizedEvent(events)) {
            saveAnomalyLog(events, "이상 이벤트 발생", "허용되지 않은 이벤트 탐지됨");
            return;
        }
        if (!isEventSequenceValid(events)) {
            saveAnomalyLog(events, "이벤트 순서 오류", "정상 흐름 불일치");
            return;
        }
        boolean isAnomalous = fastAPIService.isAnomalous(events);
        if (isAnomalous) {
            saveAnomalyLog(events, "AI 기반 이상 탐지", "LSTM 모델이 이상 패턴 감지");
            return;
        }
        for (ProductEventLog event : events) {
            event.setIsAnomaly(false); // 정상 데이터로 설정
            productEventLogRepository.save(event);
            log.info("✅ [정상 이벤트 저장] EPC={} | 모든 규칙 이상 없음", epcCode);
        }
        
        eventHistoryCache.removeEventHistory(epcCode);
    }

    private boolean isEventSequenceValid(List<ProductEventLog> events) {
        List<String> actualSequence = events.stream()
                .filter(e -> e.getEvent() != null)
                .sorted(Comparator.comparing(ProductEventLog::getEventTime))
                .map(e -> e.getEvent().getEventType())
                .collect(Collectors.toList());
        List<String> requiredSequence = getRequiredEventFlow(isDomesticProduct(events.get(0).getProduct().getEpcCode()));
        int idx = 0;
        for (String event : actualSequence) {
            if (idx < requiredSequence.size() && event.equals(requiredSequence.get(idx))) {
                idx++;
            }
        }
        return idx == requiredSequence.size();
    }

    private List<String> getRequiredEventFlow(boolean isDomestic) {
        return isDomestic ? getDomesticEventFlow() : getImportedEventFlow();
    }

    private boolean isDomesticProduct(String epcCode) {
        return epcCode != null && epcCode.startsWith(DOMESTIC_PREFIX);
    }

    private boolean isDomesticFirstEventValid(List<ProductEventLog> events) {
        String secondEventType = events.get(1).getEvent().getEventType();
        return List.of("aggregation", "WMS_inbound").contains(secondEventType);
    }

    private boolean isImportedFirstEventValid(List<ProductEventLog> events) {
        String secondEventType = events.get(1).getEvent().getEventType();
        return "custom_outbound".equals(secondEventType);
    }

    private boolean isDirectlySoldWithoutHub(List<ProductEventLog> events) {
        boolean hasHubInbound = events.stream().anyMatch(e -> "stock_inbound(HUB)".equals(e.getEvent().getEventType()));
        boolean hasSoldEvent = events.stream().anyMatch(e -> "stock_outbound(Sell)".equals(e.getEvent().getEventType()));
        return !hasHubInbound && hasSoldEvent;
    }

    private boolean hasUnauthorizedEvent(List<ProductEventLog> events) {
        List<String> unauthorizedEvents = List.of("illegal_transfer", "fake_aggregation", "unauthorized_custom");
        return events.stream().map(e -> e.getEvent().getEventType()).anyMatch(unauthorizedEvents::contains);
    }

    private void saveAnomalyLog(List<ProductEventLog> events, String anomalyType, String reason) {
        if (events == null || events.isEmpty() || events.get(0).getProduct() == null) {
            log.warn("❗ [이상 탐지 저장 실패] 필수 정보가 NULL");
            return;
        }
        ProductEventLog eventLog = events.get(0);
        String epcCode = eventLog.getProduct().getEpcCode();
        log.warn("🚨 [이상 탐지 발생] EPC={} | 유형={} | 이유={}", epcCode, anomalyType, reason);

        eventLog.setIsAnomaly(true);
        productEventLogRepository.save(eventLog);

        AnomalyLog anomalyLog = AnomalyLog.builder()
                .anomalyType(anomalyType)
                .reason(reason)
                .epcCode(epcCode)
                .anomalyTimestamp(eventLog.getEventTime())
                .anomalyEventType(eventLog.getEvent().getEventType())
                .anomalyHub(eventLog.getHub().getHubName())
                .anomalyProductName(eventLog.getProduct().getProductName())
                .latitude(eventLog.getHub().getLatitude())
                .longitude(eventLog.getHub().getLongitude())
                .productEventLog(eventLog)
                .build();

        anomalyLogRepository.save(anomalyLog);

        // WebSocket 알림
        AnomalyDTO alert = AnomalyDTO.builder()
        		.anomalyId(anomalyLog.getAnomalyId())
                .anomalyType(anomalyLog.getAnomalyType())
                .reason(anomalyLog.getReason())
                .epcCode(anomalyLog.getEpcCode())
                .anomalyProductName(anomalyLog.getAnomalyProductName())
                .anomalyHub(anomalyLog.getAnomalyHub())
                .latitude(eventLog.getHub().getLatitude())
                .longitude(eventLog.getHub().getLongitude())
                .anomalyTimestamp(eventLog.getEventTime())
                .build();
        webSocketService.sendAnomalyAlert(Collections.singletonList(alert));
    }

    private List<String> getDomesticEventFlow() {
        return List.of("commissioning", "aggregation", "WMS_inbound", "WMS_outbound",
                "stock_inbound(HUB)", "stock_outbound(HUB)",
                "stock_inbound(Wholesaler)", "stock_outbound(Wholesaler)",
                "stock_inbound(Reseller)", "stock_outbound(Sell)");
    }

    private List<String> getImportedEventFlow() {
        return List.of("custom_inbound", "custom_outbound",
                "stock_inbound(HUB)", "stock_outbound(HUB)",
                "stock_inbound(Wholesaler)", "stock_outbound(Wholesaler)",
                "stock_inbound(Reseller)", "stock_outbound(Sell)");
    }
}
