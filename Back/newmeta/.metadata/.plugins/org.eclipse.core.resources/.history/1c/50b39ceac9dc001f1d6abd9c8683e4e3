package com.newmeta.service;

import org.springframework.stereotype.Service;

import com.newmeta.domain.Hub;
import com.newmeta.persistence.HubRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class HubService {

    private final HubRepository hubRepo;

    public Hub saveIfNotExists(String hubName, Double lat, Double lon) {
        return hubRepo.findByHubName(hubName)
                .orElseGet(() -> hubRepo.save(new Hub(null, hubName, lat, lon)));
    }
}