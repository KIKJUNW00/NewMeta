package com.newmeta.service; // 📌 해당 서비스 클래스가 속한 패키지를 선언

// ✅ 필수 라이브러리 및 의존성 임포트
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.*;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.newmeta.domain.*;
import com.newmeta.domain.dto.ProductEventLogDTO;
import com.newmeta.persistence.*;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

/**
 * 📌 **제품 이벤트 로그 서비스**
 * ✅ 제품 이동 기록을 관리하고 이상 탐지를 수행하는 핵심 서비스
 * ✅ Hub, Event, Product 정보를 조회 및 저장하여 중복을 방지
 */
@Service // ✅ Spring의 Service 컴포넌트로 등록
@RequiredArgsConstructor // ✅ final 필드에 대한 생성자를 Lombok이 자동 생성
@Slf4j // ✅ 로깅 기능을 자동으로 추가하는 Lombok 어노테이션
public class ProductEventLogService {

    // ✅ JPA Repository 의존성 주입 (데이터베이스 연동)
    private final ProductEventLogRepository productEventLogRepo;
    private final ProductRepository productRepo;
    private final HubRepository hubRepo;
    private final EventRepository eventRepo;
    private final AnomalyLogRepository anomalyLogRepo;
    private final AnomalyDetectionService anomalyDetectionService; // ✅ 이상 탐지 서비스 (AI 연계)

    // ✅ 날짜 변환을 위한 포맷 설정 (yyyy-MM-dd HH:mm:ss)
    private final SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");

    /**
     * 🚀 **제품 이벤트 로그 저장**
     * ✅ 제품 이벤트 데이터를 저장하면서 중복 저장을 방지 (Hub, Event, Product)
     * ✅ 이상 탐지 서비스와 연계 가능
     */
    @Transactional
    public void saveProductEventLog(Dummy dummy) {
        try {
            log.info("🔍 [제품 이벤트 저장 요청] EPC 코드: {}, 이벤트: {}", dummy.getEpcCode(), dummy.getEventType());

            // ✅ 1. Product 조회 또는 저장
            Product product = productRepo.findById(dummy.getEpcCode())
                    .orElseGet(() -> {
                        log.info("🆕 새로운 제품 저장: EPC 코드 = {}", dummy.getEpcCode());
                        return productRepo.save(Product.builder()
                                .epcCode(dummy.getEpcCode())
                                .productName(dummy.getProductName())
                                .build());
                    });

            // ✅ 2. Hub 조회 또는 저장 (중복 방지)
            Hub hub = hubRepo.findByHubNameAndLatitudeAndLongitude(dummy.getHubType(), dummy.getLatitude(), dummy.getLongitude())
                    .orElseGet(() -> {
                        log.info("🆕 새로운 허브 저장: 허브명 = {}", dummy.getHubType());
                        return hubRepo.save(Hub.builder()
                                .hubName(dummy.getHubType())
                                .latitude(dummy.getLatitude())
                                .longitude(dummy.getLongitude())
                                .build());
                    });

            // ✅ 3. Event 조회 또는 저장 (중복 방지)
            Event event = eventRepo.findByEventType(dummy.getEventType())
                    .orElseGet(() -> {
                        log.info("🆕 새로운 이벤트 저장: 이벤트 타입 = {}", dummy.getEventType());
                        return eventRepo.save(Event.builder()
                                .eventType(dummy.getEventType())
                                .build());
                    });

            // ✅ 4. eventTime을 Date 타입으로 변환
            Date parsedEventTime = convertToDate(dummy.getEventTime());

            // ✅ 5. ProductEventLog 생성 및 저장
            ProductEventLog eventLog = ProductEventLog.builder()
                    .product(product)
                    .hub(hub)
                    .event(event)
                    .eventTime(parsedEventTime)
                    .build();

            productEventLogRepo.save(eventLog);
            log.info("✅ 제품 이벤트 로그 저장 완료: ID = {}", eventLog.getProductEventLogId());

            // ✅ 이상 탐지 연계 (현재 비활성화)
            // anomalyDetectionService.detectAnomalies(dummy, eventLog);

        } catch (Exception e) {
            log.error("❗ Error saving ProductEventLog: {}", e.getMessage(), e);
        }
    }

    /**
     * 🚀 **product_event_log_id 기준으로 페이징된 제품 이벤트 로그 조회**
     * @param pageable 페이징 요청 객체
     * @return 페이징된 제품 이벤트 로그 목록 (DTO 형태)
     */
    @Transactional(readOnly = true)
    public Page<ProductEventLogDTO> getPagedLogs(Pageable pageable) {
        log.info("📡 제품 이벤트 로그 페이징 조회 요청: 페이지={}, 크기={}", pageable.getPageNumber(), pageable.getPageSize());
        return productEventLogRepo.findPagedProductEventLogs(pageable);
    }

    /**
     * 🚀 **특정 EPC 코드로 제품 이벤트 로그 조회**
     */
    @Transactional(readOnly = true)
    public List<ProductEventLog> findLogsByEpcCode(String epcCode) {
        return productEventLogRepo.findByProductEpcCode(epcCode);
    }

    /**
     * 🚀 **특정 EPC 코드의 이동 경로 조회**
     * @param epcCode 제품의 EPC 코드
     * @return 제품 이동 경로 리스트 (JSON 변환 가능)
     */
    public List<Map<String, Object>> getProductMovement(String epcCode) {
        log.info("🔍 제품 이동 경로 조회 요청: EPC 코드 = {}", epcCode);

        List<ProductEventLog> eventLogs = productEventLogRepo.findByProductEpcCodeOrderByEventTime(epcCode);
        if (eventLogs.isEmpty()) {
            log.warn("⚠️ 제품 이동 경로 없음: EPC 코드 = {}", epcCode);
            return Collections.emptyList();
        }

        List<Map<String, Object>> movementList = new ArrayList<>();
        for (ProductEventLog log : eventLogs) {
            Map<String, Object> eventData = new HashMap<>();
            eventData.put("eventTime", log.getEventTime());
            eventData.put("hubName", log.getHub().getHubName());
            eventData.put("eventType", log.getEvent().getEventType());
            eventData.put("latitude", log.getHub().getLatitude());
            eventData.put("longitude", log.getHub().getLongitude());
            movementList.add(eventData);
        }

        log.info("✅ 제품 이동 경로 조회 완료: 총 {} 개의 이벤트", movementList.size());
        return movementList;
    }

    /**
     * ✅ **LocalDateTime을 Date로 변환**
     */
    private Date convertToDate(LocalDateTime localDateTime) {
        return localDateTime == null ? null : Date.from(localDateTime.atZone(ZoneId.systemDefault()).toInstant());
    }

    /**
     * ✅ **추가: Date 타입을 그대로 반환 (오류 방지)**
     */
    private Date convertToDate(Date date) {
        return date;
    }
}
