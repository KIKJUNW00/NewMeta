package com.newmeta.service;

import com.newmeta.domain.*;
import com.newmeta.persistence.*;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.text.ParseException;
import java.text.SimpleDateFormat;

@Service
@RequiredArgsConstructor
public class CsvReaderService {
    private final ProductRepository productRepository;
    private final HubRepository hubRepository;
    private final EventRepository eventRepository;
    private final ProductEventLogRepository productEventLogRepository;
    private final AnomalyDetectionService anomalyDetectionService;

    @Transactional
    public void processCsv(String filePath) throws IOException {
        SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm");

        try (BufferedReader reader = new BufferedReader(new FileReader(filePath))) {
            reader.readLine(); // Skip header
            String line;

            while ((line = reader.readLine()) != null) {
                String[] data = line.split(",");
                if (data.length < 7) {
                    System.out.println("Invalid row: " + line);
                    continue;
                }

                try {
                    String epcCode = data[0];
                    String productName = data[1];
                    String hubType = data[2];
                    String eventType = data[3];
                    String eventTime = parseDate(data[4], dateFormat);
                    Double latitude = parseDouble(data[5], -90, 90, "latitude");
                    Double longitude = parseDouble(data[6], -180, 180, "longitude");

                    // Save related entities or reuse existing ones
                    Product product = productRepository.findByEpcCode(epcCode)
                            .orElseGet(() -> productRepository.save(new Product(epcCode, productName)));

                    Hub hub = hubRepository.findByHubNameAndLatitudeAndLongitude(hubType, latitude, longitude)
                            .orElseGet(() -> hubRepository.save(new Hub(null, hubType, latitude, longitude)));

                    Event event = eventRepository.findByEventType(eventType)
                            .orElseGet(() -> eventRepository.save(new Event(null, eventType)));

                    // Save ProductEventLog
                    ProductEventLog eventLog = ProductEventLog.builder()
                            .product(product)
                            .hub(hub)
                            .event(event)
                            .eventTime(eventTime)
                            .build();

                    productEventLogRepository.save(eventLog);

                    // Detect anomalies
                    anomalyDetectionService.detectAnomalies(
                            new Dummy(epcCode, productName, hubType, eventType, eventTime, latitude, longitude), eventLog);

                } catch (Exception e) {
                    System.out.println("Error processing row: " + line + ", Error: " + e.getMessage());
                }
            }
        }
    }

    private String parseDate(String dateStr, SimpleDateFormat dateFormat) {
        try {
            return dateStr != null && !dateStr.isEmpty() ? dateFormat.format(dateFormat.parse(dateStr)) : null;
        } catch (ParseException e) {
            System.out.println("Invalid date format: " + dateStr);
            return null;
        }
    }

    private Double parseDouble(String value, double min, double max, String fieldName) {
        try {
            if (value == null || value.isEmpty()) {
                return null;
            }
            double parsedValue = Double.parseDouble(value);
            if (parsedValue < min || parsedValue > max) {
                System.out.println("Invalid " + fieldName + ": " + value);
                return null;
            }
            return parsedValue;
        } catch (NumberFormatException e) {
            System.out.println("Invalid number format for " + fieldName + ": " + value);
            return null;
        }
    }
}
