package com.newmeta.domain;

import java.time.LocalDateTime;

import com.fasterxml.jackson.annotation.JsonFormat;
import com.fasterxml.jackson.annotation.JsonIgnore;

import jakarta.persistence.CascadeType;
import jakarta.persistence.Entity;
import jakarta.persistence.FetchType;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.OneToOne;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Entity
@Getter
@Setter
@NoArgsConstructor
@AllArgsConstructor
@Builder
public class AnomalyLog {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long anomalyId;

    private String anomalyType; // 이상치 유형 (위변조, 불법유통 등)

    private String reason; // 이상치 판별 사유

    @JsonFormat(shape = JsonFormat.Shape.STRING, pattern = "yyyy-MM-dd HH:mm", timezone = "Asia/Seoul")
    private LocalDateTime eventTime; // 이상치 발생 시간

    private String hubType; // 이상치 발생 허브 정보
    private String eventType; // 이상치 발생 이벤트 유형

    @OneToOne(mappedBy = "anomalyLog", cascade = CascadeType.ALL, fetch = FetchType.LAZY)
    @JsonIgnore
    private ProductEventLog productEventLog;
}
