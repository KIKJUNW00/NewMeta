package com.newmeta.cache;

import com.newmeta.domain.ProductEventLog;
import org.springframework.stereotype.Component;

import java.util.*;

@Component
public class EventHistoryCache {
    
    private final Map<String, List<ProductEventLog>> eventHistoryMap = new HashMap<>();

    // 🚀 EPC 코드별 이벤트 추가
    public void addEvent(ProductEventLog eventLog) {
        eventHistoryMap.computeIfAbsent(eventLog.getProduct().getEpcCode(), k -> new ArrayList<>()).add(eventLog);
    }

    // 🚀 EPC 코드별 이벤트 목록 조회
    public List<ProductEventLog> getEventsByEpc(String epcCode) {
        return eventHistoryMap.getOrDefault(epcCode, new ArrayList<>());
    }

    // 🚀 특정 이벤트가 존재하는지 확인
    public boolean hasEvent(String epcCode, String eventType) {
        return eventHistoryMap.getOrDefault(epcCode, new ArrayList<>())
                .stream()
                .anyMatch(e -> e.getEvent().getEventType().equals(eventType));
    }

    // 🚀 특정 EPC의 이벤트 히스토리 삭제 (처리 완료 후)
    public void removeEventHistory(String epcCode) {
        eventHistoryMap.remove(epcCode);
    }
}
