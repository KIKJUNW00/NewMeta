package com.newmeta.controller;

import com.newmeta.domain.Review;
import com.newmeta.service.ReviewService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/reviews")
@RequiredArgsConstructor
public class ReviewController {

    private final ReviewService reviewService;

    // 리뷰 분석 및 저장 API
    @PostMapping
    public Review analyzeReview(@RequestBody String content) {
        return reviewService.analyzeAndSaveReview(content);
    }
}