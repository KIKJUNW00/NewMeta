package com.newmeta.websocket; // 해당 WebSocket 핸들러 클래스가 속한 패키지를 선언

import com.fasterxml.jackson.databind.ObjectMapper; // JSON 직렬화 및 역직렬화를 위한 ObjectMapper 임포트
import com.newmeta.service.SCMDataService; // SCM 데이터 서비스를 활용하기 위한 서비스 클래스 임포트
import lombok.RequiredArgsConstructor; // final 필드에 대한 생성자를 자동으로 생성하는 Lombok 어노테이션
import lombok.extern.slf4j.Slf4j; // 로깅을 위한 Lombok 어노테이션
import org.springframework.stereotype.Component; // Spring Bean으로 등록하기 위한 Component 어노테이션
import org.springframework.web.socket.*; // WebSocket 관련 기능을 제공하는 스프링 패키지
import org.springframework.web.socket.handler.TextWebSocketHandler; // WebSocket 핸들러 역할을 수행하기 위한 기본 클래스 상속

import java.io.IOException; // WebSocket 메시지 전송 시 발생할 수 있는 예외 처리
import java.util.List; // List 자료구조 활용
import java.util.Map; // Map 자료구조 활용
import java.util.concurrent.CopyOnWriteArraySet; // 동시성을 보장하는 WebSocket 세션 관리용 컬렉션

/**
 * 📡 WebSocket을 통한 실시간 데이터 제공 핸들러
 * WebSocket 연결을 관리하고 실시간 데이터를 클라이언트에 전송하는 역할
 */
@Slf4j // 로깅 기능을 제공하는 Lombok 어노테이션
@Component // Spring Bean으로 등록하여 자동으로 관리되도록 설정
@RequiredArgsConstructor // final 필드에 대한 생성자를 Lombok이 자동 생성하도록 설정
public class SCMWebSocketHandler extends TextWebSocketHandler {

    private final ObjectMapper objectMapper; // ✅ JSON 변환 객체 (Java 객체를 JSON으로 변환 및 역변환)
    private final SCMDataService scmDataService; // ✅ SCM 데이터를 제공하는 서비스 객체

    // WebSocket 세션을 관리하는 동시성 안전한 컬렉션 (여러 스레드에서 안전하게 접근 가능)
    private static final CopyOnWriteArraySet<WebSocketSession> sessions = new CopyOnWriteArraySet<>();

    /**
     * 클라이언트가 WebSocket에 연결되었을 때 호출됨
     * @param session WebSocket 세션 객체
     */
    @Override
    public void afterConnectionEstablished(WebSocketSession session) {
        sessions.add(session); // 세션을 관리 목록에 추가
        log.info("📡 WebSocket 연결됨: {}", session.getId()); // 로그 기록
    }

    /**
     * 클라이언트와의 WebSocket 연결이 종료되었을 때 호출됨
     * @param session WebSocket 세션 객체
     * @param status WebSocket 연결 종료 상태
     */
    @Override
    public void afterConnectionClosed(WebSocketSession session, CloseStatus status) {
        sessions.remove(session); // 세션을 관리 목록에서 제거
        log.info("❌ WebSocket 연결 종료: {}", session.getId()); // 로그 기록
    }

    /**
     * 클라이언트가 WebSocket을 통해 메시지를 보냈을 때 호출됨
     * @param session WebSocket 세션 객체
     * @param message 클라이언트가 전송한 메시지 객체
     */
    @Override
    public void handleTextMessage(WebSocketSession session, TextMessage message) throws IOException {
        log.info("📡 WebSocket 메시지 수신: {}", message.getPayload()); // 메시지 내용 로깅
        session.sendMessage(new TextMessage("서버 응답: " + message.getPayload())); // 클라이언트에게 응답 메시지 전송
    }

    /**
     * 📡 실시간 데이터 전송 (SCM 데이터 리스트를 JSON 형식으로 변환 후 WebSocket을 통해 전송)
     * @param data 전송할 실시간 데이터 리스트
     */
    public void sendRealTimeData(List<Map<String, Object>> data) {
        try {
            String jsonData = objectMapper.writeValueAsString(data); // 데이터를 JSON 문자열로 변환
            for (WebSocketSession session : sessions) { // 현재 연결된 모든 세션에 대해 반복
                if (session.isOpen()) { // WebSocket 세션이 열려 있는 경우에만 전송
                    session.sendMessage(new TextMessage(jsonData)); // 클라이언트에게 JSON 데이터 전송
                }
            }
        } catch (IOException e) { // 데이터 변환 또는 전송 중 오류 발생 시 예외 처리
            log.error("⚠️ WebSocket 데이터 전송 오류", e); // 에러 로그 출력
        }
    }
}
