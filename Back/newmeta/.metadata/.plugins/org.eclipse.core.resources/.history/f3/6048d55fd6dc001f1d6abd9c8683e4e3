package com.newmeta.service;

import com.newmeta.domain.Dummy;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

@Service
public class CsvReaderService {
    public List<Dummy> readCsv(String filePath) throws IOException {
        List<Dummy> list = new ArrayList<>();
        try (BufferedReader in = new BufferedReader(new FileReader(filePath))) {
            in.readLine(); // Skip header
            String line;
            while ((line = in.readLine()) != null) {
                String[] arr = line.split(",");
                if (arr.length < 7) {
                    System.out.println("Invalid data row: insufficient columns - " + line);
                    continue;
                }

                try {
                    String epcCode = arr[0];
                    String productName = arr[1];
                    String hubType = arr[2];
                    double latitude = Double.parseDouble(arr[3]);
                    double longitude = Double.parseDouble(arr[4]);
                    String eventType = arr[5];
                    String eventTime = arr[6];

                    Dummy dummy = new Dummy(epcCode, productName, hubType, eventType, eventTime, latitude, longitude);
                    list.add(dummy);
                } catch (NumberFormatException e) {
                    System.out.println("Invalid number format in row: " + line);
                }
            }
        } catch (Exception e) {
            System.out.println("Error reading CSV file: " + e.getMessage());
        }
        return list;
    }
}
