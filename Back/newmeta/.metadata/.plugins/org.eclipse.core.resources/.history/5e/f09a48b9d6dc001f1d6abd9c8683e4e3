package com.newmeta.service;

import com.newmeta.domain.AnomalyLog;
import com.newmeta.domain.Dummy;
import com.newmeta.persistence.AnomalyLogRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.List;

@Service
@RequiredArgsConstructor
public class CsvReaderService {
    private final AnomalyLogRepository anomalyLogRepository;

    public List<Dummy> readCsv(String filePath) throws IOException {
        List<Dummy> list = new ArrayList<>();
        SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm");

        try (BufferedReader in = new BufferedReader(new FileReader(filePath))) {
            in.readLine(); // Skip header
            String line;
            while ((line = in.readLine()) != null) {
                String[] arr = line.split(",");
                if (arr.length < 7) {
                    System.out.println("Invalid data row: insufficient columns - " + line);
                    saveAnomaly(null, "Insufficient columns");
                    continue;
                }

                try {
                    String epcCode = arr[0];
                    String productName = arr[1];
                    String hubType = arr[2];
                    String eventType = arr[3];
                    String eventTime = arr[4];
                    double latitude = parseDoubleWithValidation(arr[5], -90, 90, "latitude");
                    double longitude = parseDoubleWithValidation(arr[6], -180, 180, "longitude");

                    // Validate date format
                    try {
                        dateFormat.parse(eventTime);
                    } catch (ParseException e) {
                        System.out.println("Invalid date format for eventTime: " + eventTime);
                        saveAnomaly(epcCode, "Invalid event_time format");
                        continue;
                    }

                    Dummy dummy = new Dummy(epcCode, productName, hubType, eventType, eventTime, latitude, longitude);
                    list.add(dummy);
                } catch (Exception e) {
                    System.out.println("Unexpected error processing row: " + e.getMessage());
                    saveAnomaly(null, "Unexpected error");
                }
            }
        }
        return list;
    }

    private double parseDoubleWithValidation(String value, double min, double max, String fieldName) {
        try {
            double parsedValue = Double.parseDouble(value);
            if (parsedValue < min || parsedValue > max) {
                System.out.println("Invalid " + fieldName + ": " + value);
                saveAnomaly(null, "Invalid " + fieldName);
                return 0.0; // 기본값
            }
            return parsedValue;
        } catch (NumberFormatException e) {
            System.out.println("Invalid number format for " + fieldName + ": " + value);
            saveAnomaly(null, "Invalid number format for " + fieldName);
            return 0.0; // 기본값
        }
    }

    private void saveAnomaly(String epcCode, String reason) {
        AnomalyLog anomalyLog = AnomalyLog.builder()
                .epcCode(epcCode)
                .anomalyType("Data Validation Error")
                .reason(reason)
                .build();
        anomalyLogRepository.save(anomalyLog);
    }
}
