package com.newmeta.service;

import java.util.List;
import java.util.Optional;

import org.springframework.stereotype.Service;

import com.newmeta.domain.dto.AnomalyDTO;
import com.newmeta.persistence.AnomalyLogRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class AnomalyLogService {

    private final AnomalyLogRepository anomalyLogRepo;

    public List<AnomalyDTO> getAllAnomalyDetails() {
        return Optional.ofNullable(anomalyLogRepo.findAllAnomalyDetails()).orElse(Collections.emptyList());
    }

}