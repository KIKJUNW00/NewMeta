package com.newmeta.service;

import com.newmeta.domain.Dummy;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

@Service
public class CsvReaderService {

    public List<Dummy> readCsv(String filePath) throws IOException {
        List<Dummy> list = new ArrayList<>();
        try (BufferedReader in = new BufferedReader(new FileReader(filePath))) {
            String line = in.readLine(); // Skip header
            while ((line = in.readLine()) != null) {
                String[] arr = line.split(",");
                try {
                    Dummy dummy = new Dummy(arr[0], arr[1], arr[2], Double.parseDouble(arr[3]), Double.parseDouble(arr[4]), arr[5], arr[6]);
                    list.add(dummy);
                } catch (Exception e) {
                    System.out.println("Invalid data row: " + line);
                }
            }
        }
        return list;
    }
}
