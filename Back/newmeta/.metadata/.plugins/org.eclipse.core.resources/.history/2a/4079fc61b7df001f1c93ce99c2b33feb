package com.newmeta.service;

import com.newmeta.persistence.AnomalyLogRepository;
import com.newmeta.persistence.ProductEventLogRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.*;
import java.util.stream.Collectors;

/**
 * 📡 SCM 데이터 처리 서비스
 * ✅ 실시간 물류 데이터 및 이상 탐지 데이터 제공
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class SCMDataService {

    private final ProductEventLogRepository productEventLogRepository; // ✅ 제품 이벤트 로그 저장소
    private final AnomalyLogRepository anomalyLogRepository; // ✅ 이상 탐지 로그 저장소

    private final SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss"); // ✅ 날짜 포맷 설정

    /**
     * 🚀 특정 필터 조건을 적용하여 SCM 데이터를 조회
     * @param eventType 이벤트 유형 필터
     * @param hubName 허브 이름 필터
     * @param startDate 시작 날짜 필터
     * @param endDate 종료 날짜 필터
     * @return 필터링된 SCM 데이터
     */
    public Map<String, Object> getFilteredSCMData(String eventType, String hubName, String startDate, String endDate) {
        List<Map<String, Object>> filteredData = productEventLogRepository.findAll().stream()
                .filter(log -> (eventType == null || log.getEvent().getEventType().equals(eventType))) // ✅ 이벤트 유형 필터 적용
                .filter(log -> (hubName == null || log.getHub().getHubName().equals(hubName))) // ✅ 허브 필터 적용
                .filter(log -> isWithinDateRange(log.getEventTime(), startDate, endDate)) // ✅ 날짜 범위 필터 적용
                .map(log -> Map.of(
                        "epcCode", log.getProduct().getEpcCode(),
                        "productName", log.getProduct().getProductName(),
                        "hub", log.getHub().getHubName(),
                        "eventType", log.getEvent().getEventType(),
                        "eventTime", dateFormat.format(log.getEventTime())
                ))
                .collect(Collectors.toList());

        return Map.of("scmData", filteredData);
    }

    /**
     * 🚀 anomaly_log에서 특정 필터 조건을 적용하여 이상 탐지 데이터를 조회
     */
    public List<Map<String, Object>> getFilteredAnomalyData(String epcCode, String hubName, String productName) {
        return anomalyLogRepository.findAll().stream()
                .filter(log -> (epcCode == null || log.getEpcCode().equals(epcCode))) // ✅ EPC 필터 적용
                .filter(log -> (hubName == null || log.getAnomalyHub().equals(hubName))) // ✅ 허브 필터 적용
                .filter(log -> (productName == null || log.getAnomalyProductName().equals(productName))) // ✅ 제품 필터 적용
                .map(log -> Map.of(
                        "hub", log.getAnomalyHub(),
                        "product", log.getAnomalyProductName(),
                        "eventType", log.getAnomalyEventType(),
                        "status", log.getAnomalyType(),
                        "reason", log.getReason(),
                        "latitude", log.getLatitude(),
                        "longitude", log.getLongitude()
                ))
                .collect(Collectors.toList());
    }

    /**
     * ✅ 날짜 범위 내 데이터인지 검사하는 메서드
     */
    private boolean isWithinDateRange(Date eventTime, String startDate, String endDate) {
        try {
            Date start = (startDate != null) ? dateFormat.parse(startDate) : null;
            Date end = (endDate != null) ? dateFormat.parse(endDate) : null;
            return (start == null || eventTime.after(start)) && (end == null || eventTime.before(end));
        } catch (ParseException e) {
            log.warn("❌ 날짜 변환 오류: {}", e.getMessage());
            return false;
        }
    }
}
