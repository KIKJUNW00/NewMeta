package com.newmeta.service;

import com.newmeta.cache.EventHistoryCache; // 이벤트 히스토리(최근 이벤트 목록)를 메모리에 저장/조회
import com.newmeta.domain.AnomalyLog;          // 이상 탐지 기록(로그) 엔티티
import com.newmeta.domain.ProductEventLog;     // 실제로 수신된 제품 이벤트 로그 엔티티
import com.newmeta.domain.dto.AnomalyDTO;       // 이상 탐지 발생 시 WebSocket 등에 전송할 DTO
import com.newmeta.persistence.AnomalyLogRepository;      // 이상 탐지 로그 저장소 (DB 연동)
import com.newmeta.persistence.ProductEventLogRepository; // 제품 이벤트 로그 저장소 (DB 연동)
import lombok.RequiredArgsConstructor; // Lombok: 생성자 기반 의존성 주입
import lombok.extern.slf4j.Slf4j;      // Lombok: 로그 사용을 위한 어노테이션
import org.springframework.stereotype.Service;  // Spring Service 계층 어노테이션

import java.util.*;
import java.util.stream.Collectors;

/**
 * 📌 이상 탐지 로직 서비스
 *  - 이벤트가 들어올 때마다 `processEvent` 호출
 *  - 이벤트를 캐시에 저장 후, (국내/수입산 여부에 따른) "필수 이벤트" 개수가 충분하면
 *    `detectAnomalies`에서 본격적인 이상 탐지 로직을 수행
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class AnomalyDetectionService {

    /**
     * 📌 JPA Repository 의존성
     *  - anomalyLogRepository: 이상 탐지 결과(AnomalyLog) 저장
     *  - productEventLogRepository: 제품 이벤트 로그(ProductEventLog) 저장
     *  - webSocketService: WebSocket 통해 실시간 알림
     *  - eventHistoryCache: 메모리 캐시(최근 이벤트 목록)
     *  - fastAPIService: 외부 AI(FastAPI) 호출 (이상 탐지 모델)
     */
    private final AnomalyLogRepository anomalyLogRepository;
    private final ProductEventLogRepository productEventLogRepository;
    private final WebSocketService webSocketService;
    private final EventHistoryCache eventHistoryCache;
    private final FastAPIService fastAPIService;

    /**
     * 📌 국내산 / 수입산 식별을 위한 EPC 접두사 & 필수 이벤트 수(임시값)
     *  - DOMESTIC_PREFIX: "001.880" 으로 시작하면 국내산
     *  - DOMESTIC_EVENT_LIMIT: 국내산은 10개 이벤트 이상이어야 정상 흐름으로 간주
     *  - IMPORTED_EVENT_LIMIT: 수입산은 8개 이벤트 이상
     *    (실제로는 "필수 이벤트 흐름"을 정확히 확인하는 편이 더 정밀)
     */
    private static final String DOMESTIC_PREFIX = "001.880";
    private static final int DOMESTIC_EVENT_LIMIT = 10;
    private static final int IMPORTED_EVENT_LIMIT = 8;

    /**
     * 📌 이벤트 수신 → 처리 메인 로직
     * 1) 이벤트 유효성(Null 등) 체크
     * 2) DB 저장(isAnomaly=false 기본값)
     * 3) 캐시에 이벤트 추가
     * 4) 국내/수입 여부에 따라 필요한 이벤트 최소 개수 체크
     * 5) 이벤트 수가 미달하면 "필수 이벤트 미충족"(= 아직 이상 탐지 안 함)
     * 6) 충분하면 detectAnomalies 호출
     */
    public void processEvent(ProductEventLog eventLog) {
        // (1) 기본 유효성 검사
        if (eventLog == null || eventLog.getProduct() == null) {
            log.warn("❗ [processEvent] 이벤트 데이터가 NULL");
            return;
        }
        String epcCode = eventLog.getProduct().getEpcCode();

        // (2) 일단 이벤트는 정상(false) 으로 설정 후 DB 저장
        eventLog.setIsAnomaly(false);
        productEventLogRepository.save(eventLog);

        // (3) 캐시에 이벤트 추가
        eventHistoryCache.addEvent(eventLog);
        List<ProductEventLog> storedEvents = eventHistoryCache.getEventsByEpc(epcCode);

        // (4) 국내산인지 수입산인지 판별
        boolean isDomestic = isDomesticProduct(epcCode);
        // (5) 해당 국내/수입산에 필요한 최소 이벤트 개수
        int eventLimit = isDomestic ? DOMESTIC_EVENT_LIMIT : IMPORTED_EVENT_LIMIT;

        // (6) 이벤트 개수가 미달이면 "아직 필수 이벤트가 충분치 않음"
        if (storedEvents.size() < eventLimit) {
            log.warn("⏳ [이벤트 대기] EPC={} | 현재 이벤트 수={} / 필요 이벤트 수={}",
                    epcCode, storedEvents.size(), eventLimit);
            return;
        }

        // (7) 충분하면 detectAnomalies로 이상 탐지
        log.info("🚀 [이상 탐지 실행 준비 완료] EPC={} | 이벤트 수={}", epcCode, storedEvents.size());
        detectAnomalies(epcCode, storedEvents);
    }

    /**
     * 📌 이상 탐지 로직
     * 1) 국내/수입 첫 이벤트(commissioning, custom_inbound) 검사
     * 2) 허브 없이 판매, 허용되지 않은 이벤트, 이벤트 순서 체크
     * 3) FastAPIService 호출하여 ML 기반 이상치가 있는지 확인
     * 4) 이상 발생하면 AnomalyLog 저장 + WebSocket 알림
     * 5) 이상 없으면 isAnomaly=false 로 전체 갱신
     * 6) 캐시에서 제거(프로세스 완료)
     */
    private void detectAnomalies(String epcCode, List<ProductEventLog> events) {
        log.info("🚀 [detectAnomalies] EPC={} | 이벤트 수={}", epcCode, events.size());

        // (1) 국내산 첫 이벤트(valid) 체크
        if (isDomesticProduct(epcCode) && !isDomesticFirstEventValid(events)) {
            saveAnomalyLog(events, "위조", "commissioning 이후 첫 이벤트가 올바르지 않음");
            return;
        }
        // (2) 수입산 첫 이벤트(valid) 체크
        if (!isDomesticProduct(epcCode) && !isImportedFirstEventValid(events)) {
            saveAnomalyLog(events, "밀수", "custom_inbound 이후 첫 이벤트가 잘못됨");
            return;
        }
        // (3) 허브 없이 판매?
        if (isDirectlySoldWithoutHub(events)) {
            saveAnomalyLog(events, "불법 유통", "허브 이동 없이 판매 발생");
            return;
        }
        // (4) 허용되지 않은 이벤트(illegal_transfer 등)
        if (hasUnauthorizedEvent(events)) {
            saveAnomalyLog(events, "이상 이벤트 발생", "허용되지 않은 이벤트 탐지됨");
            return;
        }
        // (5) 이벤트 순서/흐름(commissioning->aggregation...) 유효성
        if (!isEventSequenceValid(events)) {
            saveAnomalyLog(events, "이벤트 순서 오류", "정상 흐름 불일치");
            return;
        }

//        // (6) 외부 AI 호출(FastAPI) → 이상치가 비어있지 않으면 = anomaly
//        boolean isAnomalous = !fastAPIService.detectAnomalies(events).isEmpty();
//        if (isAnomalous) {
//            saveAnomalyLog(events, "AI 기반 이상 탐지", "LSTM 모델이 이상 패턴 감지");
//            return;
//        }

        // (7) 모든 규칙 통과 → 정상 처리
        for (ProductEventLog event : events) {
            event.setIsAnomaly(false);
            productEventLogRepository.save(event);
            log.info("✅ [정상 이벤트 저장] EPC={} | 모든 규칙 이상 없음", epcCode);
        }

        // (8) 캐시에서 제거 → 해당 EPC 이벤트는 프로세스 완료
        eventHistoryCache.removeEventHistory(epcCode);
    }

    /**
     * 📌 이벤트 순서가 정상인지 판단
     *  - 시간순 정렬 후, 국내/수입에 맞는 requiredSequence와 대조
     */
    private boolean isEventSequenceValid(List<ProductEventLog> events) {
        // (a) 시간 기준 정렬 후, 이벤트 유형 추출
        List<String> actualSequence = events.stream()
                .filter(e -> e.getEvent() != null)
                .sorted(Comparator.comparing(ProductEventLog::getEventTime))
                .map(e -> e.getEvent().getEventType())
                .collect(Collectors.toList());

        // (b) 국내/수입 여부로 필수 시퀀스
        boolean isDomestic = isDomesticProduct(events.get(0).getProduct().getEpcCode());
        List<String> requiredSequence = getRequiredEventFlow(isDomestic);

        // (c) requiredSequence 순으로 순서대로 매칭
        int idx = 0;
        for (String evtType : actualSequence) {
            if (idx < requiredSequence.size() && evtType.equals(requiredSequence.get(idx))) {
                idx++;
            }
        }
        return (idx == requiredSequence.size());
    }

    /**
     * 📌 국내/수입산에 맞는 필수 이벤트 흐름 리스트 반환
     */
    private List<String> getRequiredEventFlow(boolean isDomestic) {
        return isDomestic ? getDomesticEventFlow() : getImportedEventFlow();
    }

    /**
     * 📌 EPC가 "001.880"으로 시작하면 국내산 판단 (임의 규칙)
     *  - 실제로는 DB나 Config로부터 동적 로딩 가능
     */
    private boolean isDomesticProduct(String epcCode) {
        return epcCode != null && epcCode.startsWith(DOMESTIC_PREFIX);
    }

    /**
     * 📌 국내산: commissioning 이후 첫 이벤트는 aggregation 또는 WMS_inbound 여야 함
     *  - 두 번째 이벤트를 체크
     */
    private boolean isDomesticFirstEventValid(List<ProductEventLog> events) {
        String secondEventType = events.get(1).getEvent().getEventType();
        return List.of("aggregation", "WMS_inbound").contains(secondEventType);
    }

    /**
     * 📌 수입산: custom_inbound 이후 첫 이벤트는 custom_outbound 여야 함
     *  - 두 번째 이벤트를 체크
     */
    private boolean isImportedFirstEventValid(List<ProductEventLog> events) {
        String secondEventType = events.get(1).getEvent().getEventType();
        return "custom_outbound".equals(secondEventType);
    }

    /**
     * 📌 허브 이동 없이 "stock_outbound(Sell)"가 발생했는지 여부
     *  - 허브 입고(stock_inbound(HUB))가 전혀 없는데 final 판매(sell)가 있다면 "불법 유통"
     */
    private boolean isDirectlySoldWithoutHub(List<ProductEventLog> events) {
        boolean hasHubInbound = events.stream()
                .anyMatch(e -> "stock_inbound(HUB)".equals(e.getEvent().getEventType()));
        boolean hasSoldEvent = events.stream()
                .anyMatch(e -> "stock_outbound(Sell)".equals(e.getEvent().getEventType()));
        return (!hasHubInbound && hasSoldEvent);
    }

    /**
     * 📌 허용되지 않은 이벤트(illegal_transfer, fake_aggregation 등) 존재 여부
     */
    private boolean hasUnauthorizedEvent(List<ProductEventLog> events) {
        List<String> unauthorizedEvents = List.of("illegal_transfer", "fake_aggregation", "unauthorized_custom");
        return events.stream()
                .map(e -> e.getEvent().getEventType())
                .anyMatch(unauthorizedEvents::contains);
    }

    /**
     * 📌 이상 탐지 발생 시 anomaly_log에 기록 + WebSocket 알림
     *  - events 중 첫 번째 이벤트를 대표로 anomalyLog 생성 (개선 필요 시 다른 방식 가능)
     */
    private void saveAnomalyLog(ProductEventLog eventLog, String anomalyType, String reason) {
        if (eventLog == null || eventLog.getProduct() == null) {
            log.warn("❗ [이상 탐지 저장 실패] eventLog 정보 부족");
            return;
        }
        String epcCode = eventLog.getProduct().getEpcCode();
        log.warn("🚨 [이상 탐지 발생] EPC={} | 유형={} | 이유={}", epcCode, anomalyType, reason);

        // 1) 해당 이벤트만 anomaly=true
        eventLog.setIsAnomaly(true);
        productEventLogRepository.save(eventLog);

        // 2) anomaly_log 생성
        AnomalyLog anomalyLog = AnomalyLog.builder()
                .anomalyType(anomalyType)
                .reason(reason)
                .epcCode(epcCode)
                .anomalyTimestamp(eventLog.getEventTime())
                .anomalyEventType(eventLog.getEvent().getEventType())
                .anomalyHub(eventLog.getHub().getHubName())
                .anomalyProductName(eventLog.getProduct().getProductName())
                .latitude(eventLog.getHub().getLatitude())
                .longitude(eventLog.getHub().getLongitude())
                .productEventLog(eventLog)
                .build();
        anomalyLogRepository.save(anomalyLog);

        // 3) WebSocket 알림
        AnomalyDTO alert = AnomalyDTO.builder()
                .anomalyId(anomalyLog.getAnomalyId())
                .anomalyType(anomalyLog.getAnomalyType())
                .reason(anomalyLog.getReason())
                .epcCode(anomalyLog.getEpcCode())
                .anomalyProductName(anomalyLog.getAnomalyProductName())
                .anomalyHub(anomalyLog.getAnomalyHub())
                .latitude(eventLog.getHub().getLatitude())
                .longitude(eventLog.getHub().getLongitude())
                .anomalyTimestamp(eventLog.getEventTime())
                .build();
        webSocketService.sendAnomalyAlert(Collections.singletonList(alert));
    }


    /**
     * 📌 국내산 이벤트 필수 흐름
     *  - 예시: commission -> aggregation -> WMS_inbound -> WMS_outbound -> ... -> stock_outbound(Sell)
     *    순서대로 나와야 정상 처리로 봄
     */
    private List<String> getDomesticEventFlow() {
        return List.of(
                "commissioning",
                "aggregation",
                "WMS_inbound",
                "WMS_outbound",
                "stock_inbound(HUB)",
                "stock_outbound(HUB)",
                "stock_inbound(Wholesaler)",
                "stock_outbound(Wholesaler)",
                "stock_inbound(Reseller)",
                "stock_outbound(Sell)"
        );
    }

    /**
     * 📌 수입산 이벤트 필수 흐름
     *  - 예시: custom_inbound -> custom_outbound -> stock_inbound(HUB) -> ... -> Sell
     */
    private List<String> getImportedEventFlow() {
        return List.of(
                "custom_inbound",
                "custom_outbound",
                "stock_inbound(HUB)",
                "stock_outbound(HUB)",
                "stock_inbound(Wholesaler)",
                "stock_outbound(Wholesaler)",
                "stock_inbound(Reseller)",
                "stock_outbound(Sell)"
        );
    }
}
