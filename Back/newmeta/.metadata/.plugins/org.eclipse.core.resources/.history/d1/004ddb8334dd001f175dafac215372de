package com.newmeta.persistence;

import java.util.List;
import java.util.Optional;
import java.util.stream.Stream;

import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

import com.newmeta.domain.Event;
import com.newmeta.domain.ProductEventLog;

@Repository
public interface ProductEventLogRepository extends JpaRepository<ProductEventLog, Long> {

    // 특정 Product와 관련된 이벤트 로그 조회
    List<ProductEventLog> findByProductEpcCode(String epcCode);

    // 특정 Product와 EventType으로 필터링된 이벤트 로그 조회
    List<ProductEventLog> findByProductEpcCodeAndEventEventType(String epcCode, String eventType);

    // 특정 Hub에서 발생한 이벤트 로그 조회
    List<ProductEventLog> findByHubHubId(Long hubId);

    // 특정 Event ID와 관련된 로그 조회
    List<ProductEventLog> findByEventEventId(Long eventId);

    // 모든 로그를 스트림으로 조회
    @Query("SELECT p FROM ProductEventLog p")
    Stream<ProductEventLog> streamAll();

    // 특정 EPC 코드로 이벤트 로그를 정렬하여 조회
    List<ProductEventLog> findByProductEpcCodeOrderByEventTimeAsc(String epcCode);

    // 페이징 처리된 로그 조회
    @Query("SELECT p FROM ProductEventLog p")
    List<ProductEventLog> findAllWithPaging(Pageable pageable);
}

