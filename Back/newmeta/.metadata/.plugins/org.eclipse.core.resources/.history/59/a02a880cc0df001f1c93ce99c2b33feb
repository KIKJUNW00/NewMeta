package com.newmeta.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.newmeta.event.SCMDataUpdateEvent;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.event.EventListener;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.Map;

/**
 * 📡 WebSocket을 통한 실시간 데이터 전송 서비스
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class WebSocketService {

    private final SimpMessagingTemplate messagingTemplate;
    private final ObjectMapper objectMapper; // ✅ JSON 변환용

    /**
     * 🚀 실시간 이상 탐지 데이터 전송
     */
    public void sendAnomalyUpdates(List<Map<String, Object>> anomalyData) {
        try {
            if (anomalyData != null && !anomalyData.isEmpty()) {
                messagingTemplate.convertAndSend("/topic/anomalyAlerts", anomalyData);
                log.info("📡 WebSocket - 이상 탐지 데이터 전송 완료: {}", anomalyData);
            } else {
                log.warn("⚠️ WebSocket - 이상 탐지 데이터가 비어 있음");
            }
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }

    /**
     * 🚀 [이벤트 리스너] - 이상 탐지 이벤트 발생 시 WebSocket으로 전송
     */
    @EventListener
    public void onSCMDataUpdate(SCMDataUpdateEvent event) {
        sendRealTimeData(event.getScmData());
    }

    /**
     * 🚀 실시간 물류 데이터 전송 (SCM 상태 업데이트)
     */
    public void sendRealTimeData(Map<String, Object> data) {
        try {
            messagingTemplate.convertAndSend("/topic/scmDataUpdate", data);
            log.info("📡 WebSocket - SCM 데이터 전송 완료: {}", data);
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }
}
