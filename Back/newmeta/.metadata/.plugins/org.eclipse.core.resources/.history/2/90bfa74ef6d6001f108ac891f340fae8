package com.newmeta.service;

import org.springframework.stereotype.Service;

import com.newmeta.domain.Review;
import com.newmeta.persistence.ReviewRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class ReviewService {

    private final ReviewRepository reviewRepository;

    public Review analyzeAndSaveReview(String review, String prediction) {

        // 데이터베이스에 저장
        Review reviewEntity = new Review();
        reviewEntity.setReview(review); // 원본 리뷰 저장
        reviewEntity.setPrediction(prediction); // 예측 결과 저장
        return reviewRepository.save(reviewEntity);
    }
}
