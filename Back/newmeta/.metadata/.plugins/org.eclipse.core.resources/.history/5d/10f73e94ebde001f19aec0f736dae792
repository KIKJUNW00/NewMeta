package com.newmeta.controller;

import com.newmeta.service.SCMDataService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import java.util.Map;

import org.springframework.messaging.handler.annotation.MessageMapping;
import org.springframework.messaging.handler.annotation.SendTo;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.bind.annotation.RestController;

@Slf4j
@RestController
@RequestMapping("/api/scm")
@RequiredArgsConstructor
public class SCMController {

    private final SCMDataService scmDataService;

    // 🔹 클라이언트가 "/app/scmData"로 메시지를 보내면 서버가 "/topic/scmDataUpdate"로 응답
    @MessageMapping("/scmData")
    @SendTo("/topic/scmDataUpdate")
    public @ResponseBody Map<String, Object> sendSCMData() { // 🔹 반환 타입을 Map<String, Object>로 변경
        log.info("📡 STOMP 기반 SCM 데이터 전송");
        return scmDataService.getSCMData(); 
    }

    @GetMapping("/data")
    public @ResponseBody Map<String, Object> getSCMData() { // 🔹 반환 타입을 Map<String, Object>로 변경
        return scmDataService.getSCMData();
    }
}
