package com.newmeta.controller;

import java.util.List;
import java.util.Map;

import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.bind.annotation.RestController;

import com.newmeta.service.SCMDataService;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@RestController
@RequestMapping("/api/scm")
@RequiredArgsConstructor
public class SCMController {

    private final SCMDataService scmDataService;
    private final SimpMessagingTemplate messagingTemplate;

    /**
     * ✅ 기존 REST API 방식으로 SCM 데이터 조회
     */
    @GetMapping("/data")
    public @ResponseBody Map<String, Object> getSCMData() {
        return scmDataService.getSCMData();
    }

    /**
     * ✅ anomaly_log에서 이상 탐지 데이터 조회
     */
    @GetMapping("/anomalies")
    public List<Map<String, Object>> getAnomalyData() {
        return scmDataService.getAnomalyData(); // 반환 타입을 List<Map<String, Object>>로 수정
    }

}
