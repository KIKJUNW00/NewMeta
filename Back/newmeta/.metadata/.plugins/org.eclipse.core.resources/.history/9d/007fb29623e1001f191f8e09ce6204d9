package com.newmeta.service;

import java.util.Date;
import java.util.List;
import java.util.Map;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;

import com.newmeta.domain.AnomalyLog;
import com.newmeta.persistence.AnomalyLogRepository;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

/**
 * 📌 이상 탐지 서비스
 * ✅ 이상 탐지 발생 시 WebSocket으로 실시간 알림 추가
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class AnomalyLogService {

    private final AnomalyLogRepository anomalyLogRepository;
    private final WebSocketService webSocketService; // ✅ 실시간 알림 서비스 추가

    /**
     * 🚀 모든 이상 탐지 데이터 조회 (페이징 포함)
     */
    public Page<AnomalyLog> getAllAnomalyDetails(Pageable pageable) {
        return anomalyLogRepository.findAll(pageable);
    }

    /**
     * 🚀 특정 EPC 코드로 이상 탐지 조회
     */
    public List<AnomalyLog> getAnomaliesByEpc(String epcCode) {
        return anomalyLogRepository.findByEpcCode(epcCode);
    }

    /**
     * 🚀 특정 제품명으로 이상 탐지 조회
     */
    public List<AnomalyLog> getAnomaliesByProduct(String productName) {
        return anomalyLogRepository.findByAnomalyProductName(productName);
    }

    /**
     * 🚀 특정 날짜 범위의 이상 탐지 조회
     */
    public List<AnomalyLog> getAnomaliesByDateRange(Date startDate, Date endDate) {
        return anomalyLogRepository.findByAnomalyTimestampBetween(startDate, endDate);
    }

    /**
     * 🚀 새로운 이상 탐지 저장 + 실시간 알림 전송
     */
    public void saveAnomaly(AnomalyLog anomalyLog) {
        anomalyLogRepository.save(anomalyLog);

        // ✅ WebSocket 알림 전송
        Map<String, Object> anomalyData = Map.of(
                "epcCode", anomalyLog.getEpcCode(),
                "anomalyType", anomalyLog.getAnomalyType(),
                "reason", anomalyLog.getReason(),
                "location", anomalyLog.getAnomalyHub(),
                "timestamp", anomalyLog.getAnomalyTimestamp()
        );

        webSocketService.sendAnomalyAlert(anomalyData);
        log.info("🚨 이상 탐지 저장 및 알림 전송 완료: {}", anomalyLog);
    }

    /**
     * 🚀 이상 탐지 데이터 삭제
     */
    public void deleteAnomaly(Long anomalyId) {
        anomalyLogRepository.deleteById(anomalyId);
        log.info("🗑️ 이상 탐지 삭제 완료: anomalyId={}", anomalyId);
    }
}
