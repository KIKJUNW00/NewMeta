package com.newmeta.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.Map;

/**
 * 📡 WebSocket을 활용한 실시간 데이터 전송 서비스
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class WebSocketService {

    private final SimpMessagingTemplate messagingTemplate;
    private final ObjectMapper objectMapper;
    private final SCMDataService scmDataService; // ✅ SCM 데이터 서비스와 연결

    /**
     * 🚨 [이상 탐지 알림 전송]
     */
    public void sendAnomalyAlert(List<Map<String, Object>> anomalyDataList) {
        try {
            for (Map<String, Object> anomalyData : anomalyDataList) {
                messagingTemplate.convertAndSend("/topic/anomalyAlerts", anomalyData);
                log.info("📡 WebSocket - 이상 탐지 알림 전송 완료: {}", anomalyData);
            }
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }

    /**
     * 🚀 [SCM 실시간 데이터 전송]
     */
    public void sendRealTimeSCMData(Map<String, Object> scmData) {
        try {
            messagingTemplate.convertAndSend("/topic/scmDataUpdate", scmData);
            log.info("📡 WebSocket - SCM 데이터 전송 완료: {}", scmData);
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }

    /**
     * 🚀 [허브별 실시간 물류 데이터 WebSocket 전송]
     */
    public void sendHubWiseData(Map<String, Object> hubWiseData) {
        try {
            messagingTemplate.convertAndSend("/topic/hubWiseData", Map.of("hubWiseData", hubWiseData));
            log.info("📡 WebSocket - 허브별 집계 데이터 전송 완료");
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }

    /**
     * ✅ 특정 필터를 적용한 실시간 SCM 데이터 WebSocket 전송
     */
    public void sendFilteredSCMData(String eventType, String hubName, String startDate, String endDate) {
        try {
            List<Map<String, Object>> filteredData = scmDataService.getFilteredSCMData(eventType, hubName, startDate, endDate);
            messagingTemplate.convertAndSend("/topic/filteredSCMData", filteredData);
            log.info("📡 WebSocket - 필터 적용 SCM 데이터 전송 완료!");
        } catch (Exception e) {
            log.error("❌ WebSocket 필터링된 SCM 데이터 전송 오류", e);
        }
    }

    /**
     * ✅ 특정 필터를 적용한 실시간 이상 탐지 데이터 WebSocket 전송
     */
    public void sendFilteredAnomalyData(String epcCode, String hubName, String productName, String startDate, String endDate) {
        try {
            List<Map<String, Object>> anomalyData = scmDataService.getFilteredAnomalyData(epcCode, hubName, productName, startDate, endDate);
            messagingTemplate.convertAndSend("/topic/filteredAnomalyData", anomalyData);
            log.info("📡 WebSocket - 필터 적용 이상 탐지 데이터 전송 완료!");
        } catch (Exception e) {
            log.error("❌ WebSocket 필터링된 이상 탐지 데이터 전송 오류", e);
        }
    }

    /**
     * ✅ 허브별 데이터 실시간 WebSocket 전송
     */
    public void sendHubWiseDataToWebSocket() {
        try {
            Map<String, Object> hubWiseData = scmDataService.getSCMData();
            messagingTemplate.convertAndSend("/topic/hubWiseData", hubWiseData);
            log.info("📡 WebSocket - 허브별 실시간 데이터 전송 완료!");
        } catch (Exception e) {
            log.error("❌ WebSocket 허브별 데이터 전송 오류", e);
        }
    }
}
