package com.newmeta.service; // 해당 서비스 클래스가 속한 패키지를 선언

import com.newmeta.domain.ProductEventLog;
import com.newmeta.persistence.AnomalyLogRepository; // 이상 탐지 로그 저장소 인터페이스 임포트
import com.newmeta.persistence.ProductEventLogRepository; // 제품 이벤트 로그 저장소 인터페이스 임포트

import lombok.RequiredArgsConstructor; // final 필드에 대한 생성자를 Lombok이 자동 생성
import lombok.extern.slf4j.Slf4j; // 로깅을 위한 Lombok 어노테이션

import org.springframework.stereotype.Service; // Spring의 서비스 계층을 나타내는 어노테이션

import java.text.ParseException; // 날짜 변환 시 발생하는 예외 처리
import java.text.SimpleDateFormat; // 날짜 포맷 변환을 위한 클래스
import java.util.*; // 컬렉션 및 Date 클래스 임포트
import java.util.stream.Collectors; // 스트림 API 사용을 위한 Collectors 임포트

/**
 * 📡 SCM 데이터 처리 서비스
 */
@Slf4j // 로깅 기능 추가
@Service // Spring의 Service 컴포넌트로 등록하여 관리되도록 설정
@RequiredArgsConstructor // final 필드에 대한 생성자를 Lombok이 자동 생성
public class SCMDataService {

    private final ProductEventLogRepository productEventLogRepository; // 제품 이벤트 로그 저장소
    private final AnomalyLogRepository anomalyLogRepository; // 이상 탐지 로그 저장소
    private final SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss"); // 날짜 변환 포맷 지정

    /**
     * 🚀 특정 필터 조건을 적용하여 SCM 데이터를 조회
     */
    public List<Map<String, Object>> getFilteredSCMData(String eventType, String hubName, String startDate, String endDate) {
        return productEventLogRepository.findAll().stream()
                .filter(log -> (eventType == null || log.getEvent().getEventType().equals(eventType)))
                .filter(log -> (hubName == null || log.getHub().getHubName().equals(hubName)))
                .filter(log -> isWithinDateRange(log.getEventTime(), startDate, endDate))
                .map(log -> {
                    Map<String, Object> result = new HashMap<>();
                    result.put("epcCode", log.getProduct().getEpcCode());
                    result.put("productName", log.getProduct().getProductName());
                    result.put("hub", log.getHub().getHubName());
                    result.put("eventType", log.getEvent().getEventType());
                    result.put("eventTime", dateFormat.format(log.getEventTime()));
                    return result;
                })
                .collect(Collectors.toList());
    }

    /**
     * 🚀 허브별 공정별 데이터를 포함한 SCM 데이터 조회
     */
    public Map<String, Object> getFilteredSCMHubWiseData(String eventType, String hubName, String startDate, String endDate) {
        List<ProductEventLog> logs = productEventLogRepository.findAll().stream()
                .filter(log -> (eventType == null || log.getEvent().getEventType().equals(eventType)))
                .filter(log -> (hubName == null || log.getHub().getHubName().equals(hubName)))
                .filter(log -> isWithinDateRange(log.getEventTime(), startDate, endDate))
                .collect(Collectors.toList());

        Map<String, Object> hubWiseData = logs.stream()
                .collect(Collectors.groupingBy(
                        log -> log.getHub().getHubName(),
                        Collectors.collectingAndThen(Collectors.toList(), this::groupByDomesticAndProcess)
                ));

        Map<String, Long> domesticTotal = countTotalByEventType(logs, true);
        Map<String, Long> importedTotal = countTotalByEventType(logs, false);
        Map<String, Long> anomalyTotal = countByAnomalies(logs);

        return Map.of(
                "hubWiseData", hubWiseData,
                "domestic_total", domesticTotal,
                "imported_total", importedTotal,
                "anomaly_total", anomalyTotal
        );
    }

    /**
     * 🚀 anomaly_log에서 특정 필터 조건을 적용하여 이상 탐지 데이터를 조회
     */
    public List<Map<String, Object>> getFilteredAnomalyData(String epcCode, String hubName, String productName, String startDate, String endDate) {
        return anomalyLogRepository.findAll().stream()
                .filter(log -> (epcCode == null || log.getEpcCode().equals(epcCode)))
                .filter(log -> (hubName == null || log.getAnomalyHub().equals(hubName)))
                .filter(log -> (productName == null || log.getAnomalyProductName().equals(productName)))
                .filter(log -> isWithinDateRange(log.getAnomalyTimestamp(), startDate, endDate))
                .map(log -> {
                    Map<String, Object> anomaly = new HashMap<>();
                    anomaly.put("AnomalyId", log.getAnomalyId());
                    anomaly.put("AnomalyProductName", log.getAnomalyProductName());
                    anomaly.put("AnomalyEventType", log.getAnomalyEventType());
                    anomaly.put("AnomalyType", log.getAnomalyType());
                    anomaly.put("AnomalyHub", log.getAnomalyHub());
                    anomaly.put("latitude", log.getLatitude());
                    anomaly.put("longitude", log.getLongitude());
                    anomaly.put("reason", log.getReason());
                    return anomaly;
                })
                .collect(Collectors.toList());
    }

    /**
     * 🚀 허브별 공정 데이터 그룹화
     */
    private Map<String, Object> groupByDomesticAndProcess(List<ProductEventLog> logs) {
        Map<String, Long> domesticCounts = countTotalByEventType(logs, true);
        Map<String, Long> importCounts = countTotalByEventType(logs, false);
        Map<String, Long> anomalyCounts = countByAnomalies(logs);
        List<String> productList = logs.stream().map(log -> log.getProduct().getProductName()).distinct().collect(Collectors.toList());

        return Map.of(
                "domestic", domesticCounts,
                "imported", importCounts,
                "anomaly", anomalyCounts,
                "products", productList
        );
    }

    /**
     * 🚀 이벤트별 제품 개수 카운트
     */
    private Map<String, Long> countTotalByEventType(List<ProductEventLog> logs, boolean isDomestic) {
        return logs.stream()
                .filter(log -> isDomestic == isDomesticProduct(log.getProduct().getEpcCode()))
                .collect(Collectors.groupingBy(log -> log.getEvent().getEventType(), Collectors.counting()));
    }

    /**
     * 🚀 이상 탐지 개수 카운트
     */
    private Map<String, Long> countByAnomalies(List<ProductEventLog> logs) {
        return logs.stream()
                .filter(ProductEventLog::getIsAnomaly)
                .collect(Collectors.groupingBy(log -> log.getEvent().getEventType(), Collectors.counting()));
    }

    /**
     * 🚀 국내산 여부 판별
     */
    private boolean isDomesticProduct(String epcCode) {
        if (epcCode == null || epcCode.isEmpty()) return false;
        String[] parts = epcCode.split("\\.");
        return parts.length > 2 && parts[1].startsWith("880");
    }

    /**
     * ✅ 날짜 범위 내 데이터인지 검사
     */
    private boolean isWithinDateRange(Date eventTime, String startDate, String endDate) {
        try {
            Date start = (startDate != null) ? dateFormat.parse(startDate) : null;
            Date end = (endDate != null) ? dateFormat.parse(endDate) : null;
            return (start == null || eventTime.after(start)) && (end == null || eventTime.before(end));
        } catch (ParseException e) {
            log.warn("❌ 날짜 변환 오류: {}", e.getMessage());
            return false;
        }
    }
}
