package com.newmeta.config; // 해당 보안 설정 파일이 속한 패키지를 선언

import org.springframework.beans.factory.annotation.Autowired; // 스프링 빈을 주입하기 위한 어노테이션
import org.springframework.context.annotation.Bean; // 스프링 빈을 등록하는 어노테이션
import org.springframework.context.annotation.Configuration; // 스프링 설정 클래스를 선언하는 어노테이션
import org.springframework.security.config.annotation.authentication.configuration.AuthenticationConfiguration; // 인증 관련 설정을 위한 클래스
import org.springframework.security.config.annotation.web.builders.HttpSecurity; // HTTP 보안 설정을 위한 빌더 클래스
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity; // 웹 보안 활성화 어노테이션
import org.springframework.security.config.http.SessionCreationPolicy; // 세션 관리 정책을 설정하기 위한 클래스
import org.springframework.security.web.SecurityFilterChain; // 보안 필터 체인을 관리하는 클래스
import org.springframework.security.web.access.intercept.AuthorizationFilter; // 인가 필터 관련 클래스

import com.newmeta.config.filter.JWTAuthenticationFilter; // JWT 기반 인증 필터 클래스
import com.newmeta.config.filter.JWTAuthorizationFilter; // JWT 기반 인가 필터 클래스
import com.newmeta.persistence.AdminRepository; // 관리자 계정 관련 JPA 리포지토리 클래스

import lombok.RequiredArgsConstructor; // final 필드에 대한 생성자를 Lombok이 자동 생성

/**
 * 📌 Spring Security 설정 파일
 * ✅ JWT 인증 및 인가를 기반으로 보안 정책을 관리
 */
@RequiredArgsConstructor // final 필드에 대한 생성자를 Lombok이 자동 생성
@Configuration // 스프링 설정 클래스
@EnableWebSecurity // Spring Security 활성화
public class SecurityConfig { // 보안 설정 파일

    @Autowired
    private AuthenticationConfiguration authenticationConfiguration; // 인증 설정을 관리하는 객체

    @Autowired
    private AdminRepository adminRepo; // 관리자 계정 정보를 관리하는 리포지토리

    /**
     * 🚀 SecurityFilterChain 설정 (Spring Security 설정)
     */
    @Bean
    SecurityFilterChain filterChain(HttpSecurity http) throws Exception {
        http.authorizeHttpRequests(security -> security
                .requestMatchers("/ws/**", "/socket.io/**").permitAll() // ✅ WebSocket 요청은 인증 없이 허용
                .requestMatchers("/login").permitAll() // ✅ 로그인 경로 허용
                .requestMatchers("/api/protected-resource").hasAuthority("ROLE_ADMIN") // ✅ 특정 API에 대한 관리자 권한 설정
                .requestMatchers("/api/**").authenticated() // ✅ API 경로는 인증된 사용자만 접근 가능
                .requestMatchers("/member/**").authenticated() // ✅ 회원 관련 경로는 인증된 사용자만 접근 가능
                .requestMatchers("/manager/**").hasAnyRole("MANAGER", "ADMIN") // ✅ 매니저 및 관리자 접근 가능
                .requestMatchers("/admin/**").hasRole("ADMIN") // ✅ 관리자 전용 접근 설정
                .anyRequest().permitAll() // ✅ 나머지 요청은 모두 허용
        );

        /**
         * 🚀 CSRF 보안 설정
         */
        http.csrf(csrf -> csrf.ignoringRequestMatchers("/ws/**", "/socket.io/**")); // ✅ WebSocket 관련 요청은 CSRF 예외 처리
        http.csrf(csrf -> csrf.disable()); // ✅ CSRF 비활성화 (JWT 사용 시 필요)

        /**
         * 🚀 CORS 설정 (Cross-Origin Resource Sharing 허용)
         */
        http.cors().and();

        /**
         * 🚀 JWT 인증 필터 설정
         */
        http.addFilter(new JWTAuthenticationFilter(authenticationConfiguration.getAuthenticationManager()));

        /**
         * 🚀 접근 거부 시 이동할 페이지 설정
         */
        http.exceptionHandling(ex -> ex.accessDeniedPage("/accessDenied"));

        /**
         * 🚀 로그아웃 설정
         */
        http.logout(logout -> logout.invalidateHttpSession(true)
                .deleteCookies("JSESSIONID")
                .logoutSuccessUrl("/login"));

        /**
         * 🚀 HTTP 기본 인증 사용 안 함
         */
        http.httpBasic(basic -> basic.disable());

        /**
         * 🚀 세션을 사용하지 않음 (JWT 사용을 위해 필요)
         */
        http.sessionManagement(sm -> sm.sessionCreationPolicy(SessionCreationPolicy.STATELESS));

        /**
         * 🚀 JWT 인증 필터에서 WebSocket 요청은 검사하지 않도록 설정 (JWTAuthorizationFilter 수정 필요)
         */
        http.addFilterBefore(new JWTAuthorizationFilter(adminRepo), AuthorizationFilter.class);

        return http.build();
    }
}
