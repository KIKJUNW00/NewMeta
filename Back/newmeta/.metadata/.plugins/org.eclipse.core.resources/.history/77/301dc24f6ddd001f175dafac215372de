package com.newmeta.domain;

import java.util.Date;
import com.fasterxml.jackson.annotation.JsonFormat;
import com.fasterxml.jackson.annotation.JsonIgnore;
import jakarta.persistence.*;

import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Entity
@Getter
@Setter
@NoArgsConstructor
@AllArgsConstructor
@Builder
public class AnomalyLog {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long anomalyId; // 기본키 (PK)

    @Column(nullable = false) // 이상치 유형 (위변조, 불법유통 등)
    private String anomalyType; 

    @Column(nullable = false) // 이상치 판별 사유
    private String reason;

    @Column(nullable = false) // 날짜 형식 설정
    @JsonFormat(shape = JsonFormat.Shape.STRING, pattern = "yyyy-MM-dd HH:mm", timezone = "Asia/Seoul")
    @Temporal(TemporalType.TIMESTAMP)
    private Date eventTime; 

    @Column(nullable = false) // 허브 타입
    private String hubType; 

    @Column(nullable = false) // 이벤트 유형
    private String eventType; 

    @OneToOne(mappedBy = "anomalyLog", cascade = CascadeType.ALL, fetch = FetchType.LAZY)
    @JsonIgnore
    private ProductEventLog productEventLog;
}
