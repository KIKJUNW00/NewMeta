package com.newmeta.config;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.authentication.configuration.AuthenticationConfiguration;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.config.http.SessionCreationPolicy;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.security.web.access.intercept.AuthorizationFilter;

import com.newmeta.config.filter.JWTAuthenticationFilter;
import com.newmeta.config.filter.JWTAuthorizationFilter;
import com.newmeta.persistence.AdminRepository;

import lombok.RequiredArgsConstructor;

@RequiredArgsConstructor
@Configuration
@EnableWebSecurity
public class SecurityConfig { // 보안 설정 클래스 (Spring Security 설정을 담당)

	// ✅ Spring Security에서 인증을 수행하는 AuthenticationManager를 가져오기 위한 설정
	@Autowired
	private AuthenticationConfiguration authenticationConfiguration;

	// ✅ Admin 정보를 조회하기 위한 JPA Repository (DB에서 사용자 정보를 조회할 때 사용)
	@Autowired
	private AdminRepository adminRepo;

	// ✅ Spring Security의 핵심 설정을 담당하는 SecurityFilterChain을 구성
	@Bean
	SecurityFilterChain filterChain(HttpSecurity http) throws Exception {
		// ✅ HTTP 요청에 대한 보안 설정
		http.authorizeHttpRequests(security -> security
				// ✅ WebSocket 관련 요청은 인증 없이 접근 허용 (JWT 검증에서 제외됨)
				.requestMatchers("/ws/**", "/socket.io/**").permitAll()
				// ✅ 로그인 요청은 누구나 접근 가능하도록 설정
				.requestMatchers("/login").permitAll()
//				// ✅ `/api/protected-resource` 경로는 ROLE_ADMIN 권한을 가진 사용자만 접근 가능
//				.requestMatchers("/api/protected-resource").hasAuthority("ROLE_ADMIN")
				// ✅ `/api/` 하위 경로는 인증된 사용자만 접근 가능
				.requestMatchers("/api/**").authenticated()
				// ✅ `/member/` 하위 경로도 인증된 사용자만 접근 가능
				.requestMatchers("/member/**").authenticated()
				// ✅ `/manager/` 하위 경로는 MANAGER 또는 ADMIN 권한을 가진 사용자만 접근 가능
				.requestMatchers("/manager/**").hasAnyRole("MANAGER", "ADMIN")
				// ✅ `/admin/` 하위 경로는 ADMIN 권한을 가진 사용자만 접근 가능
				.requestMatchers("/admin/**").hasRole("ADMIN")
				// ✅ 위에서 지정되지 않은 모든 요청은 허용 (즉, 공개된 API)
				.anyRequest().permitAll()
		);

		// ✅ 특정 경로의 CSRF 보호 기능을 비활성화 (WebSocket 관련 요청은 CSRF를 적용하지 않음)
		http.csrf(csrf -> csrf.ignoringRequestMatchers("/ws/**", "/socket.io/**"));

		// ✅ CORS 활성화 (브라우저에서 다른 도메인에서 요청을 보낼 수 있도록 허용)
		http.cors().and();
		
		// ✅ CSRF 보호를 완전히 비활성화하려면 아래 코드 사용 (현재 주석 처리됨)
		// http.csrf(csrf -> csrf.disable());

		// ✅ 접근 거부 발생 시 이동할 페이지를 지정 (403 Forbidden 발생 시 `/accessDenied`로 이동)
		http.exceptionHandling(ex -> ex.accessDeniedPage("/accessDenied"));

		// ✅ 로그아웃 설정
		http.logout(logout -> logout
				.invalidateHttpSession(true) // ✅ 세션 무효화
				.deleteCookies("JSESSIONID") // ✅ 로그아웃 시 쿠키 삭제
				.logoutSuccessUrl("/login") // ✅ 로그아웃 성공 시 이동할 경로 설정
		);

		// ✅ HTTP Basic 인증 방식 사용 안 함 (JWT 기반 인증을 사용하기 때문에 필요 없음)
		http.httpBasic(basic -> basic.disable());

		// ✅ 세션을 사용하지 않음 (STATELESS 모드 설정, JWT 기반 인증 방식 적용을 위해 필수)
		http.sessionManagement(sm -> sm.sessionCreationPolicy(SessionCreationPolicy.STATELESS));

		// ✅ JWT 인증 필터를 Spring Security 필터 체인에 추가 (로그인 요청 시 JWT 생성)
		http.addFilter(new JWTAuthenticationFilter(authenticationConfiguration.getAuthenticationManager()));

		// ✅ JWT 검증 필터를 기존 필터보다 앞에 배치 (AuthorizationFilter 이전에 실행되도록 설정)
		http.addFilterBefore(new JWTAuthorizationFilter(adminRepo), AuthorizationFilter.class);

		// ✅ 최종적으로 보안 설정을 적용한 SecurityFilterChain 객체를 반환
		return http.build();
	}
}
