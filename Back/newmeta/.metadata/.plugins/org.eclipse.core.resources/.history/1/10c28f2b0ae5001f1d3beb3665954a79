package com.newmeta.service;

import com.newmeta.domain.ProductEventLog;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import java.text.SimpleDateFormat;
import java.util.List;
import java.util.Map;
import java.util.HashMap;
import java.util.stream.Collectors;

/**
 * 📌 **FastAPI 연동 서비스 (여러 이벤트 전송)**
 * ✅ Spring Boot에서 FastAPI의 이상 탐지 모델을 호출하여 결과를 반환
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class FastAPIService {

    private final RestTemplate restTemplate = new RestTemplate();
    private final String fastApiUrl = "http://localhost:8000/detect_anomaly";
    private final SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");

    /**
     * 🚀 **FastAPI 이상 탐지 모델 호출**
     * ✅ 여러 개의 이벤트 데이터를 FastAPI로 전송하여 이상 탐지 여부 확인
     * @param events 제품 이벤트 로그 목록
     * @return 이상 탐지 결과 리스트
     */
    public List<Map<String, Object>> detectAnomalies(List<ProductEventLog> events) {
        try {
            // ✅ FastAPI에 보낼 데이터 변환 (JSON 배열)
            List<Map<String, Object>> requestData = events.stream()
                .map(this::convertToFastAPIInput)
                .collect(Collectors.toList());

            // ✅ HTTP 요청 헤더 설정 (JSON)
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);

            // ✅ FastAPI 요청 엔티티 생성 (데이터 + 헤더)
            HttpEntity<List<Map<String, Object>>> request = new HttpEntity<>(requestData, headers);

            // ✅ FastAPI에 POST 요청을 보내고 응답을 받음
            ResponseEntity<List> response = restTemplate.exchange(
                fastApiUrl, HttpMethod.POST, request, List.class);

            // ✅ 응답 본문 확인
            if (response.getBody() == null) {
                log.warn("⚠️ FastAPI 응답 없음, 빈 리스트 반환");
                return List.of();
            }

            return response.getBody();

        } catch (Exception e) {
            log.error("❌ FastAPI 이상 탐지 요청 실패: {}", e.getMessage(), e);
            return List.of();
        }
    }

    /**
     * 🚀 **이벤트 로그 데이터를 FastAPI 입력 형식으로 변환**
     * ✅ FastAPI에서 처리할 수 있는 JSON 구조로 변환
     * @param event 제품 이벤트 로그
     * @return FastAPI에 전달할 JSON 데이터 구조
     */
    private Map<String, Object> convertToFastAPIInput(ProductEventLog event) {
        Map<String, Object> data = new HashMap<>();
        data.put("epc_code", event.getProduct().getEpcCode());
        data.put("product_serial", event.getProduct().getProductSerial().toString());
        data.put("product_name", event.getProduct().getProductName() != null ? event.getProduct().getProductName() : null);
        data.put("hub_type", event.getHub().getHubName());
        data.put("event_type", event.getEvent().getEventType());
        data.put("event_time", dateFormat.format(event.getEventTime())); // 문자열로 변환
        return data;
    }
}
