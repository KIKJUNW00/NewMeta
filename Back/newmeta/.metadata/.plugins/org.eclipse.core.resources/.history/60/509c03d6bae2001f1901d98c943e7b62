@Service // Spring의 Service 컴포넌트로 등록
@RequiredArgsConstructor // final 필드에 대한 생성자를 Lombok이 자동 생성
@Slf4j // 로깅을 위한 Lombok 어노테이션 추가
public class AnomalyDetectionService {

    private final AnomalyLogRepository anomalyLogRepository; // 이상 탐지 로그 저장소
    private final ProductEventLogRepository productEventLogRepository; // 제품 이벤트 로그 저장소
    private final WebSocketService webSocketService; // ✅ 실시간 알림을 위한 WebSocket 서비스 추가
    private final RestTemplate restTemplate = new RestTemplate();
    private final String fastApiUrl = "http://localhost:8000/detect_anomaly";

    /**
     * 🚀 이상 탐지 로직 (필수 검출 규칙 적용)
     * @param dummy 더미 데이터 객체
     * @param eventLog 제품 이벤트 로그 객체
     */
    public void detectAnomalies(Dummy dummy, ProductEventLog eventLog) {
        boolean isAnomaly = false;
        String anomalyType = "";
        String reason = "";

        // ✅ [변경 사항] NULL 값 감지
        if (dummy == null || eventLog == null || eventLog.getProduct() == null) {
            log.warn("⚠️ 이상 탐지: NULL 값이 포함된 데이터 감지 (dummy={}, eventLog={})", dummy, eventLog);
            saveAnomalyLog(eventLog, "데이터 누락", "이상 탐지 시 NULL 값이 감지됨.");
            return;
        }

        String epcCode = dummy.getEpcCode();
        String eventType = dummy.getEventType();
        boolean isDomestic = isDomesticProduct(epcCode);

        log.info("🔍 EPC [{}] - 국내산 여부: {}", epcCode, isDomestic);

        // ✅ [규칙 1] 국내산은 Commissioning 필수
        if (isDomestic && !hasEventType(epcCode, "commissioning") && !eventType.equals("commissioning")) {
            isAnomaly = true;
            anomalyType = "위조";
            reason = "Commissioning 없이 다른 단계에서 감지됨.";
        }

        // ✅ [규칙 2] 수입산은 Custom_inbound 필수
        if (!isDomestic && !hasCustomInbound(epcCode) && !eventType.equals("Custom_inbound")) {
            isAnomaly = true;
            anomalyType = "밀수";
            reason = "수입산 제품이 Custom_inbound 없이 유통됨.";
        }

        // ✅ [규칙 3] Read Point에서 일련번호 누락
        if (!hasSerialNumber(epcCode)) {
            isAnomaly = true;
            anomalyType = "불법 유통";
            reason = "Read Point에서 일련번호 누락됨.";
        }

        // ✅ [규칙 4] 필수 Read Point 미검출
        if (!hasEssentialReadPoint(epcCode)) {
            isAnomaly = true;
            anomalyType = "위조 / 불법 유통";
            reason = "필수 Read Point 감지 없음.";
        }

        // ✅ [규칙 5] 이벤트 순서 오류
        if (isEventSequenceInvalid(epcCode, eventType)) {
            isAnomaly = true;
            anomalyType = "위조 / 불법 유통";
            reason = "이벤트 순서 오류 발생.";
        }
        
//     // ✅ FastAPI 딥러닝 모델 호출 (이동 패턴 기반 이상 탐지)
//        boolean aiAnomaly = detectAnomalyUsingAI(dummy);
//        if (aiAnomaly) {
//            isAnomaly = true;
//            anomalyType = "AI 기반 이상 탐지";
//            reason = "LSTM 모델이 이상 패턴 감지";
//        }

        // ✅ [추가] 이상치가 아니면 isAnomaly = false 로 저장 후 종료
        if (!isAnomaly) {
            log.info("✅ 정상 처리: EPC [{}] - 이벤트 [{}]", epcCode, eventType);
            eventLog.setIsAnomaly(false);
            productEventLogRepository.save(eventLog);
            return;
        }

        // ✅ [추가] 이상치로 판정된 경우 product_event_log.isAnomaly = true
        eventLog.setIsAnomaly(true);
        productEventLogRepository.save(eventLog);

        // ✅ 이상 탐지된 경우 anomalyLog 저장
        saveAnomalyLog(eventLog, anomalyType, reason);
    }

    /**
     * ✅ anomaly_log 저장 + WebSocket 실시간 알림 추가
     */
    private void saveAnomalyLog(ProductEventLog eventLog, String anomalyType, String reason) {
    	if (eventLog == null || eventLog.getProduct() == null || eventLog.getEvent() == null || eventLog.getHub() == null) {
            log.warn("❗ 이벤트 로그, 제품 정보, 이벤트 또는 허브 정보가 NULL, anomalyLog 생성 중단");
            return;
        }

        String epcCode = eventLog.getProduct().getEpcCode();
        String eventType = eventLog.getEvent().getEventType();

        // ✅ 이미 anomaly_log에 동일 epcCode가 있는지 확인
        boolean alreadyExists = anomalyLogRepository.existsByEpcCode(epcCode);
        if (alreadyExists) {
            log.info("❗ EPC [{}] 이미 anomaly_log 등록됨, 중복 저장 생략", epcCode);
            return;
        }

        // ✅ anomaly_log 저장
        AnomalyLog anomalyLog = AnomalyLog.builder()
                .anomalyType(anomalyType)
                .reason(reason)
                .epcCode(epcCode)
                .anomalyTimestamp(eventLog.getEventTime())
                .anomalyEventType(eventType)
                .anomalyHub(eventLog.getHub().getHubName())
                .anomalyProductName(eventLog.getProduct().getProductName())
                .latitude(eventLog.getHub().getLatitude())
                .longitude(eventLog.getHub().getLongitude())
                .productEventLog(eventLog) // productEventLog 설정
                .build();

        anomalyLogRepository.save(anomalyLog);

     // ✅ WebSocket 실시간 알림 전송 (DTO 사용)
        AnomalyDTO anomalyAlert = AnomalyDTO.builder()
                .anomalyType(anomalyLog.getAnomalyType())
                .reason(anomalyLog.getReason())
                .epcCode(anomalyLog.getEpcCode())
                .anomalyTimestamp(anomalyLog.getAnomalyTimestamp())
                .anomalyEventType(anomalyLog.getAnomalyEventType())
                .anomalyHub(anomalyLog.getAnomalyHub())
                .anomalyProductName(anomalyLog.getAnomalyProductName())
                .latitude(anomalyLog.getLatitude())
                .longitude(anomalyLog.getLongitude())
                .build();

        try {
            webSocketService.sendAnomalyAlert(Collections.singletonList(anomalyAlert));
        } catch (Exception e) {
            log.error("🚨 WebSocket 알림 전송 실패: {}", e.getMessage(), e);
        }

        log.info("🚨 이상 탐지 기록됨 + WebSocket 알림 전송 완료: EPC [{}] - {}, 위치: ({}, {})",
                epcCode, reason, eventLog.getHub().getLatitude(), eventLog.getHub().getLongitude());
    }

    /**
     * 🚀 국내산 여부 확인 (EPC 코드 기반, "880" 포함 여부 확인)
     */
    private boolean isDomesticProduct(String epcCode) {
        if (epcCode == null || epcCode.isEmpty()) return false;
        String[] parts = epcCode.split("\\.");
        return parts.length > 2 && parts[1].startsWith("880");
    }

    /**
     * ✅ 특정 EPC 코드와 이벤트 타입 존재 여부 확인
     */
    private boolean hasEventType(String epcCode, String eventType) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, eventType);
    }

    /**
     * ✅ Custom_inbound 이벤트 존재 여부 확인
     */
    private boolean hasCustomInbound(String epcCode) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, "Custom_inbound");
    }

    /**
     * ✅ Read Point에서 일련번호 존재 여부 확인
     */
    private boolean hasSerialNumber(String epcCode) {
        return productEventLogRepository.existsByProductEpcCode(epcCode);
    }

    /**
     * ✅ 필수 Read Point 감지 여부 확인
     */
    private boolean hasEssentialReadPoint(String epcCode) {
        List<String> essentialEvents = Arrays.asList("commissioning", "Custom_inbound", "WMS_inbound");
        return essentialEvents.stream().anyMatch(evt -> productEventLogRepository
                .existsByProductEpcCodeAndEventEventType(epcCode, evt));
    }

    /**
     * ✅ 이벤트 순서 오류 확인
     */
    private boolean isEventSequenceInvalid(String epcCode, String eventType) {
        return productEventLogRepository.existsByProductEpcCodeAndEventEventType(epcCode, "event_order_error");
    }
    
