package com.newmeta.service; // 해당 서비스 클래스가 속한 패키지를 선언

import com.fasterxml.jackson.databind.ObjectMapper; // JSON 직렬화 및 역직렬화를 위한 Jackson 라이브러리 임포트
import lombok.RequiredArgsConstructor; // final 필드에 대한 생성자를 Lombok이 자동 생성
import lombok.extern.slf4j.Slf4j; // 로깅을 위한 Lombok 어노테이션
import org.springframework.messaging.simp.SimpMessagingTemplate; // WebSocket 메시지 전송을 위한 Spring 메시징 템플릿
import org.springframework.stereotype.Service; // Spring의 서비스 계층을 나타내는 어노테이션

import java.util.List; // 리스트 데이터 처리
import java.util.Map; // 키-값 형태의 데이터 저장을 위한 Map 클래스

/**
 * 📡 WebSocket을 활용한 실시간 알림 서비스
 */
@Slf4j // 로깅 기능 자동 추가
@Service // Spring의 Service 컴포넌트로 등록하여 관리되도록 설정
@RequiredArgsConstructor // final 필드에 대한 생성자를 Lombok이 자동 생성
public class WebSocketService {

    private final SimpMessagingTemplate messagingTemplate; // WebSocket 메시지 전송을 위한 Spring 메시징 템플릿
    private final ObjectMapper objectMapper; // JSON 데이터 변환을 위한 Jackson ObjectMapper 객체

    /**
     * 🚨 [이상 탐지 알림 전송] - 특정 이상치에 대한 실시간 알림
     * @param anomalyData 전송할 이상 탐지 데이터
     */
    public void sendAnomalyAlert(Map<String, Object> anomalyData) {
        try {
            messagingTemplate.convertAndSend("/topic/anomalyAlerts", anomalyData); // WebSocket 메시지 전송
            log.info("📡 WebSocket - 이상 탐지 알림 전송 완료: {}", anomalyData);
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }

    /**
     * 🚀 [SCM 실시간 데이터 전송] - 물류 데이터 업데이트
     * @param scmData 전송할 SCM 데이터
     */
    public void sendRealTimeSCMData(Map<String, Object> scmData) {
        try {
            messagingTemplate.convertAndSend("/topic/scmDataUpdate", scmData); // WebSocket 메시지 전송
            log.info("📡 WebSocket - SCM 데이터 전송 완료: {}", scmData);
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }

    /**
     * 🚀 [이상 탐지 데이터 일괄 전송] - 여러 개의 이상 탐지 정보를 실시간으로 전송
     * @param anomalyList 전송할 이상 탐지 데이터 리스트
     */
    public void sendAnomalyUpdates(List<Map<String, Object>> anomalyList) {
        try {
            if (anomalyList == null || anomalyList.isEmpty()) { // 데이터가 없는 경우 경고 로그 출력 후 중단
                log.warn("⚠️ WebSocket - 이상 탐지 데이터가 비어 있음");
                return;
            }
            messagingTemplate.convertAndSend("/topic/anomalyAlerts", anomalyList); // WebSocket 메시지 전송
            log.info("📡 WebSocket - 이상 탐지 데이터 전송 완료: {}", anomalyList);
        } catch (Exception e) {
            log.error("❌ WebSocket 전송 오류", e);
        }
    }
}
