package com.newmeta.service.scheduler;

import java.io.IOException;
import java.util.List;

import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import com.newmeta.domain.Dummy;
import com.newmeta.service.CsvReaderService;
import com.newmeta.service.ProductEventLogService;

import lombok.RequiredArgsConstructor;

@Component
@RequiredArgsConstructor
public class CsvScheduler {

    private final CsvReaderService csvReaderService;
    private final ProductEventLogService productEventLogService;

    @Scheduled(fixedRate = 100000) // 매 1초마다 실행
    public void processCsvData() throws IOException {
        String filePath = "C:\\test/Dummy_1_utf8.csv";
        List<Dummy> dummies = csvReaderService.readCsv(filePath);

        for (Dummy dummy : dummies) {
            productEventLogService.saveProductEventLog(dummy);
        }
    }
}