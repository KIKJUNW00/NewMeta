package com.newmeta.service.scheduler; // 해당 스케줄러 클래스가 속한 패키지를 선언

import org.springframework.scheduling.annotation.Scheduled; // 스케줄링 기능을 제공하는 어노테이션 임포트
import org.springframework.stereotype.Component; // Spring Bean으로 등록하기 위한 Component 어노테이션

import com.newmeta.service.CsvReaderService; // CSV 파일을 읽고 처리하는 서비스 클래스 임포트

import lombok.RequiredArgsConstructor; // final 필드에 대한 생성자를 자동으로 생성하는 Lombok 어노테이션

/**
 * CSV 파일을 일정 주기로 읽어오는 스케줄러
 * 일정 시간마다 `CsvReaderService`를 호출하여 CSV 데이터를 처리하는 역할
 */
@Component // Spring Bean으로 등록하여 자동으로 관리되도록 설정
@RequiredArgsConstructor // final 필드에 대한 생성자를 Lombok이 자동 생성하도록 설정
public class CsvScheduler {

    private final CsvReaderService csvReaderService; // CSV 데이터를 처리하는 서비스 객체

    /**
     * 일정 주기마다 CSV 파일을 처리하는 메서드
     * @Scheduled(fixedRate = 1000) -> 1초마다 실행
     * `fixedRate`는 이전 작업이 완료되지 않아도 일정 간격(1초)마다 실행됨
     */
    @Scheduled(fixedDelay = 1000) // 1분 간격으로 실행 (fixedRate 대신 fixedDelay 사용) 
    public void processCsvFile() {
        csvReaderService.processCsvLine(); // 한 줄씩 CSV 데이터를 처리하도록 변경
    }
}
