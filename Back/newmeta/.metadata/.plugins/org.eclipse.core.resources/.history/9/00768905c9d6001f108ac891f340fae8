package com.newmeta.service;

import com.newmeta.domain.Review;
import com.newmeta.persistence.ReviewRepository;

import lombok.RequiredArgsConstructor;

import java.util.Map;

import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

@Service
@RequiredArgsConstructor
public class ReviewService {

    private final ReviewRepository reviewRepository;

    public Review analyzeAndSaveReview(String content) {
        RestTemplate restTemplate = new RestTemplate(); // 외부 API 호출 도구
        String apiUrl = "http://localhost:8000/predict"; // FastAPI URL

        // FastAPI에 데이터 전송 및 결과 받기
        String prediction = restTemplate.postForObject(apiUrl, Map.of("review", content), String.class);

        // 데이터베이스에 저장
        Review review = new Review();
        review.setContent(content);
        review.setPrediction(prediction);
        return reviewRepository.save(review);
    }
}