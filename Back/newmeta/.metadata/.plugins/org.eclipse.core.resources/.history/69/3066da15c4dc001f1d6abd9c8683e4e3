package com.newmeta.service;

import org.springframework.stereotype.Service;

import com.newmeta.domain.Hub;
import com.newmeta.persistence.HubRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class HubService {

    private final HubRepository hubRepo;

    public Hub save(String hubName, Double lat, Double lon) {
        Hub hub = new Hub(null, hubName, lat, lon);
        return hubRepo.save(hub);
    }
}