package com.newmeta.domain;

import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
@AllArgsConstructor
@Builder
public class Dummy {
    private String epcCode;       // EPC 코드
    private String productName;   // 제품 이름
    private String hubType;       // 허브 유형
    private String eventType;     // 이벤트 유형
    private LocalDateTime eventTime; // 이벤트 발생 시간 (LocalDateTime 변경)
    private Double latitude;      // 위도
    private Double longitude;     // 경도

    private static final DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");

    // String 날짜 데이터를 LocalDateTime으로 변환하는 생성자
    public Dummy(String epcCode, String productName, String hubType, String eventType, String eventTimeStr, Double latitude, Double longitude) {
        this.epcCode = epcCode;
        this.productName = productName;
        this.hubType = hubType;
        this.eventType = eventType;
        this.eventTime = parseToLocalDateTime(eventTimeStr); // LocalDateTime 변환
        this.latitude = latitude;
        this.longitude = longitude;
    }

    private LocalDateTime parseToLocalDateTime(String eventTimeStr) {
        return eventTimeStr != null && !eventTimeStr.isEmpty() ? LocalDateTime.parse(eventTimeStr, formatter) : null;
    }
}
