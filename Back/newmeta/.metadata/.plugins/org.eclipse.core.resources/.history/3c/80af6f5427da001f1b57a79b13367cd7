 // 모든 이벤트 로그를 스트림으로 처리하여 DTO로 변환
    public List<ProductEventLogDTO> getAllLogsAsDTO() {
        try (Stream<ProductEventLog> stream = productEventLogRepo.streamAll()) {
            return stream.map(this::convertToDTO) // DTO 변환 메서드 호출
                         .peek(entityManager::detach) // Persistence Context에서 detach 처리
                         .collect(Collectors.toList());
        }
    }

    // ProductEventLog 엔티티를 ProductEventLogDTO로 변환
    private ProductEventLogDTO convertToDTO(ProductEventLog producteventLog) {
        return new ProductEventLogDTO(
        		producteventLog.getSeq(),
        		producteventLog.getEventTime().toString(),
        		producteventLog.isCfStatus(),
        		producteventLog.isIdStatus(),
        		producteventLog.getProduct().getEpcCode(),
        		producteventLog.getProduct().getProductName(),
        		producteventLog.getEvent().getEventType(),
        		producteventLog.getHub().getHubName(),
        		producteventLog.getHub().getLatitude(),
        		producteventLog.getHub().getLongitude()
        );
    }

    // 모든 이벤트 로그 조회
    public List<ProductEventLog> findAllLogs() {
        return productEventLogRepo.findAll();
    }

    // 특정 ID로 이벤트 로그 조회
    public Optional<ProductEventLog> findLogById(Long seq) {
        return productEventLogRepo.findById(seq);
    }

    // 특정 EPC 코드로 이벤트 로그 조회
    public List<ProductEventLog> findLogsByEpcCode(String epcCode) {
        return productEventLogRepo.findByProductEpcCode(epcCode);
    }

    // 새로운 이벤트 로그 저장
    public ProductEventLog saveLog(ProductEventLog log) {
        return productEventLogRepo.save(log);
    }

    public void deleteLog(Long id) {
    	productEventLogRepo.deleteById(id);
    }
